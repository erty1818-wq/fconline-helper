                <GeometryDrawing Pen="{StaticResource PenBase}" Geometry="M3,11.5 L11.5,3 H17 C17.6,3 18,3.4 18,4 V9.5 L9.5,18 C9.1,18.4 8.5,18.4 8.1,18 L3,12.9 C2.6,12.5 2.6,11.9 3,11.5 Z" />
                <!-- Hole -->
                <GeometryDrawing Brush="{StaticResource IconBase}" Geometry="M14.5,5.5 A1.2,1.2 0 1 0 14.5,7.9 A1.2,1.2 0 1 0 14.5,5.5 Z" />
                <!-- Down arrow in accent -->
                <GeometryDrawing Pen="{StaticResource PenAccent}" Geometry="M17.5,13 V21 M14.5,18 L17.5,21 L20.5,18" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="Icon.Nav.Value.Active">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z" />
                <GeometryDrawing Pen="{StaticResource PenActive}" Geometry="M3,11.5 L11.5,3 H17 C17.6,3 18,3.4 18,4 V9.5 L9.5,18 C9.1,18.4 8.5,18.4 8.1,18 L3,12.9 C2.6,12.5 2.6,11.9 3,11.5 Z" />
                <GeometryDrawing Brush="{StaticResource IconAccent}" Geometry="M14.5,5.5 A1.2,1.2 0 1 0 14.5,7.9 A1.2,1.2 0 1 0 14.5,5.5 Z" />
                <GeometryDrawing Pen="{StaticResource PenAccent}" Geometry="M17.5,13 V21 M14.5,18 L17.5,21 L20.5,18" />
