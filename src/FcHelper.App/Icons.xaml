                <GeometryDrawing Brush="{StaticResource IconAccentGradient}" Pen="{StaticResource PenAccent}" Geometry="M13,17.5 H17.5 C18.9,17.5 20,18.6 20,20 C20,21.4 18.9,22.5 17.5,22.5 C16.1,22.5 15,21.4 15,20 V19 H13 Z" />
