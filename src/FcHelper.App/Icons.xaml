                <GeometryDrawing Brush="{StaticResource IconAccent}" Geometry="M12,4.5 A1.5,1.5 0 1 0 12,7.5 A1.5,1.5 0 1 0 12,4.5 Z" />
                <GeometryDrawing Pen="{StaticResource PenAccent}" Geometry="M9,10 L12,8 L15,10 M12,8 V11 M10.5,11 L10,13 M13.5,11 L14,13" />
