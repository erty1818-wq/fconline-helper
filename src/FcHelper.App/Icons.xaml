                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z" />
                <!-- Board -->
                <GeometryDrawing Pen="{StaticResource PenBase}" Geometry="M4,2.5 H20 C20.8,2.5 21.5,3.2 21.5,4 V20 C21.5,20.8 20.8,21.5 20,21.5 H4 C3.2,21.5 2.5,20.8 2.5,20 V4 C2.5,3.2 3.2,2.5 4,2.5 Z" />
                <!-- Halfway line & penalty box -->
                <GeometryDrawing Pen="{StaticResource PenBaseThin}" Geometry="M2.5,12 H21.5 M8,2.5 V7 H16 V2.5" />
                <GeometryDrawing Pen="{StaticResource PenBaseThin}" Geometry="M12,9.5 A2.5,2.5 0 1 0 12,14.5 A2.5,2.5 0 1 0 12,9.5" />
