    <!-- Icon.Nav.Grade: Step bars + up arrow -->
    <DrawingImage x:Key="Icon.Nav.Grade">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z" />
                <!-- Baseline -->
                <GeometryDrawing Pen="{StaticResource PenBase}" Geometry="M3,20 H21" />
                <!-- Step bars -->
                <GeometryDrawing Pen="{StaticResource PenBaseThin}" Geometry="M5,20 V16 H8 V20 M10,20 V12 H13 V20" />
                <!-- Highest bar in accent -->
                <GeometryDrawing Brush="{StaticResource IconAccentGradient}" Geometry="M15,8 H18 V20 H15 Z" />
                <!-- Upward trend arrow -->
                <GeometryDrawing Pen="{StaticResource PenAccent}" Geometry="M6,12 L11,7 L19,3 M15,3 H19 V7" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="Icon.Nav.Grade.Active">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z" />
                <GeometryDrawing Pen="{StaticResource PenActive}" Geometry="M3,20 H21" />
                <GeometryDrawing Pen="{StaticResource PenActiveThin}" Geometry="M5,20 V16 H8 V20 M10,20 V12 H13 V20" />
                <GeometryDrawing Brush="{StaticResource IconAccentGradient}" Geometry="M15,8 H18 V20 H15 Z" />
                <GeometryDrawing Pen="{StaticResource PenAccent}" Geometry="M6,12 L11,7 L19,3 M15,3 H19 V7" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Icon.Nav.Salary: Balance scale -->
