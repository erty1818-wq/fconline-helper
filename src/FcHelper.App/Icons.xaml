    <!-- Icon.Home.Manager: Tactical clipboard + coach whistle -->
    <DrawingImage x:Key="Icon.Home.Manager">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z" />
                <!-- Clipboard board -->
