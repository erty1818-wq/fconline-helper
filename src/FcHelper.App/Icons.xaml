                <!-- Stand -->
                <GeometryDrawing Pen="{StaticResource PenBase}" Geometry="M12,4 V20 M8,20 H16" />
                <!-- Top beam -->
                <GeometryDrawing Pen="{StaticResource PenBase}" Geometry="M5,7 L12,5.5 L19,7" />
                <!-- Left pan -->
                <GeometryDrawing Pen="{StaticResource PenBaseThin}" Geometry="M5,7 L2.5,13 M5,7 L7.5,13" />
                <GeometryDrawing Pen="{StaticResource PenBase}" Geometry="M2,13 C2,15.5 8,15.5 8,13 Z" />
                <!-- Right pan (Accent) -->
                <GeometryDrawing Pen="{StaticResource PenActiveThin}" Geometry="M19,7 L16.5,13 M19,7 L21.5,13" />
                <GeometryDrawing Brush="{StaticResource IconAccentSoft}" Pen="{StaticResource PenAccent}" Geometry="M16,13 C16,15.5 22,15.5 22,13 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="Icon.Nav.Salary.Active">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z" />
                <GeometryDrawing Pen="{StaticResource PenActive}" Geometry="M12,4 V20 M8,20 H16" />
                <GeometryDrawing Pen="{StaticResource PenActive}" Geometry="M5,7 L12,5.5 L19,7" />
                <GeometryDrawing Pen="{StaticResource PenActiveThin}" Geometry="M5,7 L2.5,13 M5,7 L7.5,13" />
                <GeometryDrawing Pen="{StaticResource PenActive}" Geometry="M2,13 C2,15.5 8,15.5 8,13 Z" />
                <GeometryDrawing Pen="{StaticResource PenActiveThin}" Geometry="M19,7 L16.5,13 M19,7 L21.5,13" />
                <GeometryDrawing Brush="{StaticResource IconAccentSoft}" Pen="{StaticResource PenAccent}" Geometry="M16,13 C16,15.5 22,15.5 22,13 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Icon.Nav.Trends: Price chart line -->
    <DrawingImage x:Key="Icon.Nav.Trends">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z" />
                <!-- Axes -->
                <GeometryDrawing Pen="{StaticResource PenBase}" Geometry="M3,4 V20 H21" />
                <!-- Trend line -->
                <GeometryDrawing Pen="{StaticResource PenAccent}" Geometry="M4,15 L9,11 L13,14 L20,6" />
                <!-- Target arrowhead -->
                <GeometryDrawing Pen="{StaticResource PenAccent}" Geometry="M16,6 H20 V10" />
                <!-- Under-curve soft area -->
                <GeometryDrawing Brush="{StaticResource IconAccentSoft}" Geometry="M4,15 L9,11 L13,14 L20,6 V20 H4 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="Icon.Nav.Trends.Active">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z" />
                <GeometryDrawing Pen="{StaticResource PenActive}" Geometry="M3,4 V20 H21" />
                <GeometryDrawing Pen="{StaticResource PenAccent}" Geometry="M4,15 L9,11 L13,14 L20,6" />
                <GeometryDrawing Pen="{StaticResource PenAccent}" Geometry="M16,6 H20 V10" />
                <GeometryDrawing Brush="{StaticResource IconAccentSoft}" Geometry="M4,15 L9,11 L13,14 L20,6 V20 H4 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Icon.Nav.MySquad: Jersey shirt -->
    <DrawingImage x:Key="Icon.Nav.MySquad">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z" />
                <!-- Shirt outline -->
                <GeometryDrawing Pen="{StaticResource PenBase}" Geometry="M6,4.5 L2.5,7.5 L4.5,10.5 L7,8.5 V20 C7,20.6 7.4,21 8,21 H16 C16.6,21 17,20.6 17,20 V8.5 L19.5,10.5 L21.5,7.5 L18,4.5 H14 C14,6 10,6 10,4.5 Z" />
                <!-- Collar V-neck in Accent -->
                <GeometryDrawing Pen="{StaticResource PenAccent}" Geometry="M10,4.5 L12,7.5 L14,4.5" />
                <!-- Number / Badge on chest -->
                <GeometryDrawing Brush="{StaticResource IconAccent}" Geometry="M12,11 A1.5,1.5 0 1 0 12,14 A1.5,1.5 0 1 0 12,11 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="Icon.Nav.MySquad.Active">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z" />
                <GeometryDrawing Pen="{StaticResource PenActive}" Geometry="M6,4.5 L2.5,7.5 L4.5,10.5 L7,8.5 V20 C7,20.6 7.4,21 8,21 H16 C16.6,21 17,20.6 17,20 V8.5 L19.5,10.5 L21.5,7.5 L18,4.5 H14 C14,6 10,6 10,4.5 Z" />
                <GeometryDrawing Pen="{StaticResource PenAccent}" Geometry="M10,4.5 L12,7.5 L14,4.5" />
                <GeometryDrawing Brush="{StaticResource IconAccent}" Geometry="M12,11 A1.5,1.5 0 1 0 12,14 A1.5,1.5 0 1 0 12,11 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Icon.Nav.Opponent: Shield + Target crosshair -->
    <DrawingImage x:Key="Icon.Nav.Opponent">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z" />
                <!-- Shield -->
                <GeometryDrawing Pen="{StaticResource PenBase}" Geometry="M12,21.5 C6,18.5 4,13.5 4,7.5 V4 L12,2.5 L20,4 V7.5 C20,13.5 18,18.5 12,21.5 Z" />
