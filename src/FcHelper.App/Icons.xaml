                <GeometryDrawing Pen="{StaticResource PenBase}" Geometry="M10.5,4 A6.5,6.5 0 1 0 10.5,17 A6.5,6.5 0 1 0 10.5,4 Z" />
                <!-- Glass handle -->
                <GeometryDrawing Pen="{StaticResource PenBase}" Geometry="M15.5,15.5 L21,21" />
                <!-- Star inside lens in Accent -->
                <GeometryDrawing Brush="{StaticResource IconAccentGradient}" Geometry="M10.5,6.5 L11.6,8.8 L14,9.2 L12.2,10.9 L12.7,13.3 L10.5,12.1 L8.3,13.3 L8.8,10.9 L7,9.2 L9.4,8.8 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="Icon.Nav.Picks.Active">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z" />
                <GeometryDrawing Pen="{StaticResource PenActive}" Geometry="M10.5,4 A6.5,6.5 0 1 0 10.5,17 A6.5,6.5 0 1 0 10.5,4 Z" />
                <GeometryDrawing Pen="{StaticResource PenActive}" Geometry="M15.5,15.5 L21,21" />
                <GeometryDrawing Brush="{StaticResource IconAccentGradient}" Geometry="M10.5,6.5 L11.6,8.8 L14,9.2 L12.2,10.9 L12.7,13.3 L10.5,12.1 L8.3,13.3 L8.8,10.9 L7,9.2 L9.4,8.8 Z" />
