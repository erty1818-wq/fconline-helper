                <GeometryDrawing Brush="{StaticResource IconBase}" Geometry="M9,2.5 H15 V5.5 H9 Z" />
                <!-- Tactical X and O marks -->
                <GeometryDrawing Pen="{StaticResource PenBaseThin}" Geometry="M8,9 L10,11 M10,9 L8,11 M14,10 A1.2,1.2 0 1 0 14,12.4 A1.2,1.2 0 1 0 14,10 Z" />
