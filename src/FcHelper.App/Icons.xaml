    <!-- Icon.Home.Search: Large magnifying glass scanning opponent shield -->
    <DrawingImage x:Key="Icon.Home.Search">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z" />
                <!-- Background shield -->
                <GeometryDrawing Pen="{StaticResource PenBaseThin}" Geometry="M14,19.5 C10,17.5 8,14 8,10 V6.5 L14,5 L20,6.5 V10 C20,14 18,17.5 14,19.5 Z" />
