                <!-- Chemistry center core dot -->
                <GeometryDrawing Brush="{StaticResource IconAccent}" Geometry="M12,11.5 A1.2,1.2 0 1 0 12,13.9 A1.2,1.2 0 1 0 12,11.5 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="Icon.Nav.TeamColor.Active">
        <DrawingImage.Drawing>
            <DrawingGroup>
