                <GeometryDrawing Brush="{StaticResource IconAccent}" Geometry="M12,10.5 A1,1 0 1 0 12,12.5 A1,1 0 1 0 12,10.5 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="Icon.Nav.Opponent.Active">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z" />
                <GeometryDrawing Pen="{StaticResource PenActive}" Geometry="M12,21.5 C6,18.5 4,13.5 4,7.5 V4 L12,2.5 L20,4 V7.5 C20,13.5 18,18.5 12,21.5 Z" />
