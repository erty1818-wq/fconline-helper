<!--
    FC Online Helper - Duotone Vector Icon Set
    Style: Duotone with #E8EAED base lines (stroke 1.8, round caps/joins) and #3DDC97 accent fills/lines.
    Bee badge: Special high-detail badge with #FFC43D -> #F5A623 gradient, dark stripes, and translucent wings.
    ViewBox: 24x24 standard vector coordinates for crisp display at any DPI (100%, 125%, 150%).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared Brushes -->
    <SolidColorBrush x:Key="IconBase" Color="#E8EAED" />
    <SolidColorBrush x:Key="IconBaseMuted" Color="#9AA3AE" />
    <SolidColorBrush x:Key="IconAccent" Color="#3DDC97" />
    <SolidColorBrush x:Key="IconAccentSoft" Color="#333DDC97" />
    <SolidColorBrush x:Key="IconInfo" Color="#6CB6FF" />
    <SolidColorBrush x:Key="IconWarn" Color="#FFB547" />
    <SolidColorBrush x:Key="IconDanger" Color="#FF6B6B" />

    <LinearGradientBrush x:Key="IconAccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3DDC97" Offset="0" />
        <GradientStop Color="#2BB57A" Offset="1" />
    </LinearGradientBrush>

    <!-- Honey Bee Colors -->
    <LinearGradientBrush x:Key="HoneyBodyGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFC43D" Offset="0" />
        <GradientStop Color="#F5A623" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="HoneyStripe" Color="#2A2118" />
    <SolidColorBrush x:Key="HoneyHalo" Color="#33FFC43D" />
    <SolidColorBrush x:Key="HoneyWingFill" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="HoneyWingStroke" Color="#CCFFFFFF" />

    <!-- Shared Pens -->
    <Pen x:Key="PenBase" Brush="{StaticResource IconBase}" Thickness="1.8" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
    <Pen x:Key="PenBaseThin" Brush="{StaticResource IconBase}" Thickness="1.3" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
    <Pen x:Key="PenActive" Brush="{StaticResource IconAccent}" Thickness="1.8" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
    <Pen x:Key="PenActiveThin" Brush="{StaticResource IconAccent}" Thickness="1.3" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
    <Pen x:Key="PenAccent" Brush="{StaticResource IconAccent}" Thickness="1.8" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
    <Pen x:Key="PenInfo" Brush="{StaticResource IconInfo}" Thickness="1.8" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
    <Pen x:Key="PenWarn" Brush="{StaticResource IconWarn}" Thickness="1.8" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
    <Pen x:Key="PenDanger" Brush="{StaticResource IconDanger}" Thickness="1.8" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />

    <!-- ====================================================================== -->
    <!-- 1. NAVIGATION ICONS (Menu 9 items + Active variants)                    -->
    <!-- ====================================================================== -->

    <!-- Icon.Nav.Squad: Tactical pitch + player dots (4-2-2-2) -->
    <DrawingImage x:Key="Icon.Nav.Squad">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z" />
                <!-- Pitch frame -->
                <GeometryDrawing Pen="{StaticResource PenBase}" Geometry="M4,3 H20 C20.6,3 21,3.4 21,4 V20 C21,20.6 20.6,21 20,21 H4 C3.4,21 3,20.6 3,20 V4 C3,3.4 3.4,3 4,3 Z" />
                <!-- Halfway line -->
                <GeometryDrawing Pen="{StaticResource PenBaseThin}" Geometry="M3,12 H21" />
                <!-- Center circle -->
                <GeometryDrawing Pen="{StaticResource PenBaseThin}" Geometry="M12,9.5 A2.5,2.5 0 1 0 12,14.5 A2.5,2.5 0 1 0 12,9.5" />
                <!-- Key player dots in accent (Attackers & CMs) -->
                <GeometryDrawing Brush="{StaticResource IconAccent}" Geometry="M8.5,6.5 A1.2,1.2 0 1 0 8.5,8.9 A1.2,1.2 0 1 0 8.5,6.5 M15.5,6.5 A1.2,1.2 0 1 0 15.5,8.9 A1.2,1.2 0 1 0 15.5,6.5 M12,17 A1.2,1.2 0 1 0 12,19.4 A1.2,1.2 0 1 0 12,17" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="Icon.Nav.Squad.Active">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z" />
                <GeometryDrawing Pen="{StaticResource PenActive}" Geometry="M4,3 H20 C20.6,3 21,3.4 21,4 V20 C21,20.6 20.6,21 20,21 H4 C3.4,21 3,20.6 3,20 V4 C3,3.4 3.4,3 4,3 Z" />
                <GeometryDrawing Pen="{StaticResource PenActiveThin}" Geometry="M3,12 H21" />
                <GeometryDrawing Pen="{StaticResource PenActiveThin}" Geometry="M12,9.5 A2.5,2.5 0 1 0 12,14.5 A2.5,2.5 0 1 0 12,9.5" />
                <GeometryDrawing Brush="{StaticResource IconAccent}" Geometry="M8.5,6.5 A1.2,1.2 0 1 0 8.5,8.9 A1.2,1.2 0 1 0 8.5,6.5 M15.5,6.5 A1.2,1.2 0 1 0 15.5,8.9 A1.2,1.2 0 1 0 15.5,6.5 M12,17 A1.2,1.2 0 1 0 12,19.4 A1.2,1.2 0 1 0 12,17" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

