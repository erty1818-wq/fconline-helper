<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 19041: Windows OCR through FcHelper.Vision. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>FcHelper</AssemblyName>
    <!-- Compared with the release page's tag for updates: raise it with every release. -->
    <Version>0.10.2</Version>
    <RootNamespace>FcHelper.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The exe's icon in Explorer and the taskbar; windows and the tray use the same file. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Keep the resident footprint small: no background GC thread, give memory back when idle. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avoid clashes between WPF and WinForms types; WinForms is referenced by full name where used. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Speech" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- Screenshots of the official pages for the first-run API key guide. -->
    <Resource Include="Assets\ApiGuide\*.png" />
    <Resource Include="Assets\app.ico" />
    <!-- The default artwork (docs/SKIN_ASSETS.md) ships inside the exe, so every PC and every update gets it; a PNG in
         the skin folder still replaces it. -->
    <!-- Icons are vectors (Icons.xaml) by default: the old one-colour icon PNGs are not built in. -->
    <Resource Include="skin\*.png" Exclude="skin\nav-*.png;skin\home-search.png;skin\home-squad.png;skin\home-manager.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FcHelper.Services\FcHelper.Services.csproj" />
    <ProjectReference Include="..\FcHelper.Vision\FcHelper.Vision.csproj" />
    <ProjectReference Include="..\FcHelper.Market\FcHelper.Market.csproj" />
  </ItemGroup>

</Project>
