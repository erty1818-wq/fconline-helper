<Window x:Class="FcHelper.App.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:FcHelper.App"
        Title="구단주 검색 · FC Online Helper" Width="440" Height="720" MinWidth="360" MinHeight="300"
        Background="{StaticResource Bg}" ShowInTaskbar="True" WindowStartupLocation="Manual">
    <Window.Resources>
        <!-- One line of the card: text followed by the evidence badge (직접/계산/추정). -->
        <DataTemplate x:Key="InsightLine">
            <DockPanel Margin="0,2">
                <Border DockPanel.Dock="Right" Style="{StaticResource Badge}">
                    <TextBlock Text="{Binding Badge}" FontSize="11" Foreground="{StaticResource Muted}" />
                </Border>
                <TextBlock Text="{Binding Text}" />
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="ShareBar">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Foreground="{StaticResource Muted}" />
                <ProgressBar Grid.Column="1" Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="6"
                             Background="{StaticResource Panel}" Foreground="{StaticResource Info}" BorderThickness="0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Display}" TextAlignment="Right" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="PlainLine">
            <TextBlock Text="{Binding}" Margin="0,1" />
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <Button x:Name="SearchButton" DockPanel.Dock="Right" Content="검색" Margin="6,0,0,0" Click="OnSearchClick" IsDefault="True" />
            <Grid>
                <TextBox x:Name="NicknameBox" ToolTip="상대 닉네임 (Enter로 검색)" TextChanged="OnNicknameChanged" />
                <!-- Placeholder while the box is empty -->
                <TextBlock Text="상대 구단주 닉네임" Foreground="{StaticResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text.Length, ElementName=NicknameBox}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DockPanel>

        <StackPanel Grid.Row="1">
            <!-- Autocomplete: nicknames already in the local DB. Inline, not a Popup: popups float above the game. -->
            <WrapPanel x:Name="SuggestBar" Margin="0,4,0,0" Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" Margin="0,6,0,0" Foreground="{StaticResource Muted}" FontSize="12" />
        </StackPanel>

        <DockPanel Grid.Row="2" Margin="0,6,0,0">
        <!-- Tabs of the analysis (docs/opponent-search/PLAN.md): 요약 is the light card used in game, the rest go deeper. -->
        <WrapPanel x:Name="TabBar" DockPanel.Dock="Top" Margin="0,0,0,6" Visibility="Collapsed" />
        <Grid>
        <!-- Before a search: the start screen (OS-01 fills it). -->
        <ScrollViewer x:Name="StartPanel" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="StartContent">
                <!-- Favourites, recent searches and recent opponents: filled by SearchWindow.RefreshStart. -->
                <StackPanel x:Name="StartLists" />
                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,12,0,0"
                           Text="상대 구단주 닉네임을 넣고 [검색]을 누르세요. 게임 중에는 Ctrl + Alt + S로 이 창을 열고, 단축키 모드에서는 매칭 화면에서 Ctrl + Alt + F로 상대 닉네임을 읽어 옵니다." />
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="SummaryTab" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel x:Name="Card">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Controller}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                    <Button x:Name="FavoriteButton" DockPanel.Dock="Left" Style="{StaticResource Ghost}" Padding="2" Margin="0,0,6,0"
                            VerticalAlignment="Center" Click="OnFavoriteClick" ToolTip="즐겨찾기에 넣기 / 빼기" />
                    <TextBlock Text="{Binding Header}" FontSize="19" FontWeight="Bold" />
                </DockPanel>
                <TextBlock Text="{Binding PreviousNicknames}" Foreground="{StaticResource Muted}" FontSize="12" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HeadToHead}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HeadToHead}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Image Source="{app:Icon Rematch}" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding HeadToHead}" Foreground="{StaticResource Warn}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding Record}" Margin="0,4,0,0" />
                <TextBlock Text="{Binding Averages}" Foreground="{StaticResource Muted}" />

                <Border Background="{StaticResource Panel}" CornerRadius="6" Padding="10,8" Margin="0,10,0,0">
                    <TextBlock Text="{Binding OneLine}" FontSize="14" FontWeight="SemiBold" />
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,3">
                    <Image Source="{app:Icon Warning}" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource Section}" Text="주의" Foreground="{StaticResource Danger}" Margin="0" VerticalAlignment="Center" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Threats}" ItemTemplate="{StaticResource InsightLine}" />

                <StackPanel Orientation="Horizontal" Margin="0,10,0,3">
                    <Image Source="{app:Icon Target}" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource Section}" Text="약점" Foreground="{StaticResource Accent}" Margin="0" VerticalAlignment="Center" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Weakness}" ItemTemplate="{StaticResource InsightLine}" />
                <ItemsControl ItemsSource="{Binding Matchups}" ItemTemplate="{StaticResource InsightLine}" Margin="0,2,0,0" />

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Signature}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Signature}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Image Source="{app:Icon Signature}" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Signature}" Foreground="{StaticResource Info}" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Style="{StaticResource Section}" Text="위험 선수" />
                <ItemsControl ItemsSource="{Binding DangerPlayers}" ItemTemplate="{StaticResource PlainLine}" />

                <TextBlock Style="{StaticResource Section}" Text="특징" />
                <ItemsControl ItemsSource="{Binding Traits}" ItemTemplate="{StaticResource InsightLine}" />

                <StackPanel Orientation="Horizontal" Margin="0,10,0,3">
                    <Image Source="{app:Icon Note}" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource Section}" Text="메모" Margin="0" VerticalAlignment="Center" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Tags}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Style="{StaticResource Tag}" IsChecked="{Binding IsChecked, Mode=TwoWay}">
                                <TextBlock Text="{Binding Name}" FontSize="12" />
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <DockPanel Margin="0,2,0,0">
                    <Button DockPanel.Dock="Right" Content="저장" Margin="6,0,0,0" Click="OnSaveMemoClick" />
                    <TextBox Text="{Binding MemoText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="13" />
                </DockPanel>

                <Expander Header="상세 분석" Foreground="{StaticResource Text}" Margin="0,12,0,0">
                    <StackPanel Margin="0,4,0,0">
                        <TextBlock Style="{StaticResource Section}" Text="득점 방식" />
                        <ItemsControl ItemsSource="{Binding GoalTypes}" ItemTemplate="{StaticResource ShareBar}" />
                        <TextBlock Style="{StaticResource Section}" Text="득점 위치" />
                        <ItemsControl ItemsSource="{Binding GoalZones}" ItemTemplate="{StaticResource ShareBar}" />
                        <TextBlock Style="{StaticResource Section}" Text="실점 방식" />
                        <ItemsControl ItemsSource="{Binding ConcededTypes}" ItemTemplate="{StaticResource ShareBar}" />
                        <TextBlock Style="{StaticResource Section}" Text="실점 위치" />
                        <ItemsControl ItemsSource="{Binding ConcededZones}" ItemTemplate="{StaticResource ShareBar}" />
                        <TextBlock Style="{StaticResource Section}" Text="패스 구성" />
                        <ItemsControl ItemsSource="{Binding PassMix}" ItemTemplate="{StaticResource ShareBar}" />
                        <TextBlock Style="{StaticResource Section}" Text="선수" />
                        <ItemsControl ItemsSource="{Binding Players}" ItemTemplate="{StaticResource PlainLine}" />
                        <TextBlock Style="{StaticResource Section}" Text="득점 조합 (도움 → 득점)" />
                        <ItemsControl ItemsSource="{Binding Combos}" ItemTemplate="{StaticResource PlainLine}" />
                        <TextBlock Style="{StaticResource Section}" Text="기타 수치" />
                        <ItemsControl ItemsSource="{Binding Numbers}" ItemTemplate="{StaticResource PlainLine}" />
                    </StackPanel>
                </Expander>

                <TextBlock Text="{Binding SampleNote}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0" />
            </StackPanel>
        </ScrollViewer>
        <!-- The deeper tabs: each fills its StackPanel from code (SearchWindow.Tabs). -->
        <ScrollViewer x:Name="SquadTab" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"><StackPanel x:Name="SquadContent" /></ScrollViewer>
        <ScrollViewer x:Name="ShotsTab" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"><StackPanel x:Name="ShotsContent" /></ScrollViewer>
        <ScrollViewer x:Name="FlowTab" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"><StackPanel x:Name="FlowContent" /></ScrollViewer>
        <ScrollViewer x:Name="CompareTab" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"><StackPanel x:Name="CompareContent" /></ScrollViewer>
        <ScrollViewer x:Name="PlayersTab" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"><StackPanel x:Name="PlayersContent" /></ScrollViewer>
        <ScrollViewer x:Name="MineTab" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"><StackPanel x:Name="MineContent" /></ScrollViewer>
        </Grid>
        </DockPanel>

        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="이 상대 맞춤 추천" Click="OnTailorClick" x:Name="TailorButton" Visibility="Collapsed"
                    ToolTip="이 상대에게 맞는 카드와 포메이션 (스쿼드·시세 창)" />
            <TextBlock Text="Data based on NEXON Open API" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>
