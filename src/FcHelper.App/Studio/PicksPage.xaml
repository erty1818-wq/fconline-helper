<UserControl x:Class="FcHelper.App.Studio.PicksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:studio="clr-namespace:FcHelper.App.Studio"
             xmlns:app="clr-namespace:FcHelper.App">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource CardPanel}" Margin="0,0,0,10">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <Button x:Name="FindButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="찾기" Click="OnFind" />
                    <StackPanel>
                        <TextBlock Text="숨은 랭커픽" Style="{StaticResource H1}" />
                        <TextBlock Style="{StaticResource Hint}" Text="상위 랭커들이 실제로 쓰는데, 같은 스펙 카드보다 싸게 거래되는 카드 (랭커 사용 = 전날 공식경기 · 예상가 [추정])" />
                    </StackPanel>
                </DockPanel>
                <WrapPanel>
                    <StackPanel Margin="0,0,14,6"><TextBlock Text="포지션" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="PositionBox" SelectionChanged="OnPositionChanged" /></StackPanel>
                    <StackPanel Margin="0,0,14,6"><TextBlock Text="최소 사용 랭커 수" Style="{StaticResource FieldLabel}" /><TextBox x:Name="UsersBox" Width="80" Text="10" /></StackPanel>
                </WrapPanel>
                <studio:FilterPanel x:Name="Filters" />
            </StackPanel>
        </Border>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button x:Name="LockButton" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Click="OnLock">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{app:Icon Lock}" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="선택한 선수를 스쿼드에 고정" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock x:Name="Status" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
        </DockPanel>
        <DataGrid x:Name="Results">
            <DataGrid.Columns>
                <DataGridTextColumn Header="포지션" Binding="{Binding Position}" Width="60" />
                <DataGridTemplateColumn Header="꿀" Width="36">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{app:Icon Honey}" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="꿀선수: 같은 스펙 카드보다 30% 이상 싸게 거래">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Honey}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Honey}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="" Width="42">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><Image Width="34" Height="34" studio:Pictures.FaceOf="{Binding SpId}" RenderOptions.BitmapScalingMode="HighQuality" /></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="선수" Binding="{Binding Name}" Width="130" />
                <DataGridTemplateColumn Header="시즌" Width="105" SortMemberPath="Season">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Image Width="22" Height="22" studio:Pictures.SeasonOf="{Binding Season}" RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="{Binding Season}" Margin="4,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="강화" Binding="{Binding Grade}" Width="50" />
                <DataGridTextColumn Header="OVR" Binding="{Binding Ovr}" Width="50" />
                <DataGridTextColumn Header="코어" Binding="{Binding Core}" Width="50" ElementStyle="{StaticResource Num}" />
                <DataGridTextColumn Header="키" Binding="{Binding Height}" Width="45" />
                <DataGridTextColumn Header="랭커" Binding="{Binding Users}" Width="60" ElementStyle="{StaticResource Num}" />
                <DataGridTextColumn Header="사용률" Binding="{Binding Share}" Width="60" ElementStyle="{StaticResource Num}" />
                <DataGridTextColumn Header="시세" Binding="{Binding Price}" Width="90" ElementStyle="{StaticResource Num}" />
                <DataGridTextColumn Header="예상가 [추정]" Binding="{Binding Expected}" Width="100" ElementStyle="{StaticResource Num}" />
                <DataGridTextColumn Header="차이" Binding="{Binding Diff}" Width="70" ElementStyle="{StaticResource Good}" />
                <DataGridTextColumn Header="특성 · 개인기 · 체형" Binding="{Binding Tags}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
