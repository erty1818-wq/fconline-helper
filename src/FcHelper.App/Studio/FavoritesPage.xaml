<UserControl x:Class="FcHelper.App.Studio.FavoritesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:studio="clr-namespace:FcHelper.App.Studio">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource CardPanel}" Margin="0,0,0,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="선택한 카드 빼기" Click="OnRemove" />
                <StackPanel>
                    <TextBlock Text="즐겨찾기" Style="{StaticResource H1}" />
                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                               Text="선수 정보 창에서 넣은 카드입니다. 목표가를 넣은 카드는 시세가 갱신될 때 그 아래로 내려오면 트레이 알림으로 알려 드립니다. 두 번 누르면 선수 정보를 엽니다." />
                </StackPanel>
            </DockPanel>
        </Border>
        <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Foreground="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap" />
        <DataGrid x:Name="Results" MouseDoubleClick="OnOpen">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="42">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><Image Width="34" Height="34" studio:Pictures.FaceOf="{Binding SpId}" RenderOptions.BitmapScalingMode="HighQuality" /></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="선수" Binding="{Binding Name}" Width="170" />
                <DataGridTemplateColumn Header="시즌" Width="100" SortMemberPath="Season">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Image Width="22" Height="22" studio:Pictures.SeasonOf="{Binding Season}" RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="{Binding Season}" Margin="4,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="강화" Binding="{Binding Grade}" Width="50" />
                <DataGridTextColumn Header="OVR" Binding="{Binding Ovr}" Width="50" />
                <DataGridTextColumn Header="급여" Binding="{Binding Pay}" Width="46" />
                <DataGridTextColumn Header="시세" Binding="{Binding Price}" Width="90" ElementStyle="{StaticResource Num}" />
                <DataGridTextColumn Header="목표가" Binding="{Binding Target}" Width="90" ElementStyle="{StaticResource Num}" />
                <DataGridTextColumn Header="목표까지" Binding="{Binding Gap}" Width="80" ElementStyle="{StaticResource Num}" />
                <DataGridTextColumn Header="상태" Binding="{Binding State}" Width="100" />
                <DataGridTextColumn Header="특성" Binding="{Binding Traits}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
