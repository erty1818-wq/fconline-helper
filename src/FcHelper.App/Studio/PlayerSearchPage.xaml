<UserControl x:Class="FcHelper.App.Studio.PlayerSearchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:market="clr-namespace:FcHelper.Market;assembly=FcHelper.Market"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Player search on the official data center, with every condition its search takes. -->
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource CardPanel}" Margin="0,0,0,10">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button x:Name="SearchButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="검색" Click="OnSearch" IsDefault="True" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="조건 초기화" Click="OnReset" Margin="0,0,8,0" Padding="10,4" VerticalAlignment="Center" />
                    <ToggleButton x:Name="MoreToggle" DockPanel.Dock="Right" Style="{StaticResource Chip}" Content="조건 접기" IsChecked="True" Click="OnMoreToggle" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="선수 검색" Style="{StaticResource H1}" />
                        <TextBlock Style="{StaticResource Hint}" Text="공식 데이터센터의 선수 검색입니다. 조건을 고르고 [검색]을 누르세요 (Enter)." />
                    </StackPanel>
                </DockPanel>
                <!-- Name: always visible -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Left" Text="선수명" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Width="60" />
                    <TextBox x:Name="NameBox" ToolTip="초성 검색(ㅁㅅ) 가능, 쉼표로 여러 명: 메시,호날두" />
                </DockPanel>
                <ScrollViewer x:Name="Conditions" MaxHeight="430" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Seasons -->
                        <DockPanel Margin="0,4,0,4">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="전체 해제" Click="OnSeasonsClear" Padding="8,2" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="전체 선택" Click="OnSeasonsAll" Padding="8,2" Margin="0,0,6,0" />
                            <ToggleButton x:Name="SeasonsToggle" DockPanel.Dock="Right" Style="{StaticResource Chip}" Content="클래스 펴기" Click="OnSeasonsToggle" Margin="0,0,6,0" />
                            <TextBlock x:Name="SeasonsLabel" Text="클래스: 전체" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        </DockPanel>
                        <WrapPanel x:Name="SeasonGrid" Visibility="Collapsed" Margin="0,0,0,6" />
                        <!-- Positions -->
                        <TextBlock Text="포지션" Style="{StaticResource FieldLabel}" Margin="0,6,0,2" />
                        <WrapPanel x:Name="PositionGrid" Margin="0,0,0,6" />
                        <!-- Club, nation, team colour -->
                        <WrapPanel>
                            <StackPanel Margin="0,0,12,6"><TextBlock Text="리그" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="LeagueBox" Width="170" SelectionChanged="OnLeagueChanged" /></StackPanel>
                            <StackPanel Margin="0,0,12,6"><TextBlock Text="클럽" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="ClubBox" TextSearch.TextPath="Name" Width="170" IsTextSearchEnabled="True" /></StackPanel>
                            <StackPanel Margin="0,0,12,6"><TextBlock Text="대륙" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="ConfedBox" Width="110" SelectionChanged="OnConfedChanged" /></StackPanel>
                            <StackPanel Margin="0,0,12,6"><TextBlock Text="국적" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="NationBox" TextSearch.TextPath="Name" Width="150" IsTextSearchEnabled="True" /></StackPanel>
                            <CheckBox x:Name="HistoryBox" Content="클럽 경력 포함" VerticalAlignment="Bottom" Margin="0,0,12,10" ToolTip="고른 클럽에서 뛴 적이 있는 선수까지" />
                            <StackPanel Margin="0,0,12,6"><TextBlock Text="팀컬러" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="TeamColorBox" TextSearch.TextPath="Name" Width="200" IsTextSearchEnabled="True" /></StackPanel>
                        </WrapPanel>
                        <!-- Grade, adaptability, team colour level; OVR, salary, price -->
                        <WrapPanel>
                            <StackPanel Margin="0,0,12,6"><TextBlock Text="강화" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="GradeBox" Width="70" /></StackPanel>
                            <StackPanel Margin="0,0,12,6"><TextBlock Text="적응도" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="GrowBox" Width="60" /></StackPanel>
                            <StackPanel Margin="0,0,12,6"><TextBlock Text="팀컬러 단계" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="ColorLevelBox" Width="60" ToolTip="표시되는 OVR에 더할 팀컬러 단계 (데이터센터와 같음)" /></StackPanel>
                            <StackPanel Margin="0,0,12,6">
                                <TextBlock Text="오버롤" Style="{StaticResource FieldLabel}" />
                                <StackPanel Orientation="Horizontal"><TextBox x:Name="OvrMinBox" Width="50" /><TextBlock Text="~" Margin="4,0" VerticalAlignment="Center" /><TextBox x:Name="OvrMaxBox" Width="50" /></StackPanel>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,6">
                                <TextBlock Text="급여" Style="{StaticResource FieldLabel}" />
                                <StackPanel Orientation="Horizontal"><TextBox x:Name="PayMinBox" Width="40" /><TextBlock Text="~" Margin="4,0" VerticalAlignment="Center" /><TextBox x:Name="PayMaxBox" Width="40" /></StackPanel>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,6">
                                <TextBlock Text="시세 (억, 고른 강화)" Style="{StaticResource FieldLabel}" ToolTip="{x:Static market:Bp.InputHint}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="PriceMinBox" Width="60" ToolTip="{x:Static market:Bp.InputHint}" /><TextBlock Text="~" Margin="4,0" VerticalAlignment="Center" />
                                    <TextBox x:Name="PriceMaxBox" Width="60" ToolTip="{x:Static market:Bp.InputHint}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,6"><TextBlock Text="개인기" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="SkillBox" Width="80" /></StackPanel>
                            <StackPanel Margin="0,0,12,6"><TextBlock Text="명성" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="RepBox" Width="80" /></StackPanel>
                        </WrapPanel>
                        <!-- Detailed stats and traits -->
                        <WrapPanel x:Name="StatRows" />
                        <WrapPanel>
                            <StackPanel Margin="0,0,12,6">
                                <TextBlock Text="포함할 특성 (모두 보유)" Style="{StaticResource FieldLabel}" />
                                <StackPanel Orientation="Horizontal"><ComboBox x:Name="Trait1" Width="130" Margin="0,0,4,0" /><ComboBox x:Name="Trait2" Width="130" Margin="0,0,4,0" /><ComboBox x:Name="Trait3" Width="130" /></StackPanel>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,6">
                                <TextBlock Text="제외할 특성" Style="{StaticResource FieldLabel}" />
                                <StackPanel Orientation="Horizontal"><ComboBox x:Name="NoTrait1" Width="130" Margin="0,0,4,0" /><ComboBox x:Name="NoTrait2" Width="130" Margin="0,0,4,0" /><ComboBox x:Name="NoTrait3" Width="130" /></StackPanel>
                            </StackPanel>
                        </WrapPanel>
                        <!-- Body -->
                        <WrapPanel>
                            <StackPanel Margin="0,0,12,6"><TextBlock Text="주발" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="FootBox" Width="80" /></StackPanel>
                            <StackPanel Margin="0,0,12,6"><TextBlock Text="약발" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="WeakBox" Width="70" /></StackPanel>
                            <StackPanel Margin="0,0,12,6">
                                <TextBlock Text="키 (cm)" Style="{StaticResource FieldLabel}" />
                                <StackPanel Orientation="Horizontal"><TextBox x:Name="HeightMinBox" Width="45" /><TextBlock Text="~" Margin="4,0" VerticalAlignment="Center" /><TextBox x:Name="HeightMaxBox" Width="45" /></StackPanel>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,6">
                                <TextBlock Text="몸무게 (kg)" Style="{StaticResource FieldLabel}" />
                                <StackPanel Orientation="Horizontal"><TextBox x:Name="WeightMinBox" Width="45" /><TextBlock Text="~" Margin="4,0" VerticalAlignment="Center" /><TextBox x:Name="WeightMaxBox" Width="45" /></StackPanel>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,6"><TextBlock Text="체형" Style="{StaticResource FieldLabel}" /><WrapPanel x:Name="BodyGrid" /></StackPanel>
                            <StackPanel Margin="0,0,12,6">
                                <TextBlock Text="생년 (월·일)" Style="{StaticResource FieldLabel}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="BirthMinBox" Width="50" /><TextBlock Text="~" Margin="4,0" VerticalAlignment="Center" /><TextBox x:Name="BirthMaxBox" Width="50" Margin="0,0,6,0" />
                                    <ComboBox x:Name="BirthMonthBox" Width="60" Margin="0,0,4,0" /><ComboBox x:Name="BirthDayBox" Width="60" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,6">
                                <TextBlock Text="선수 평점" Style="{StaticResource FieldLabel}" />
                                <StackPanel Orientation="Horizontal"><TextBox x:Name="RatingMinBox" Width="40" /><TextBlock Text="~" Margin="4,0" VerticalAlignment="Center" /><TextBox x:Name="RatingMaxBox" Width="40" /></StackPanel>
                            </StackPanel>
                        </WrapPanel>
                        <!-- Order and columns -->
                        <WrapPanel>
                            <StackPanel Margin="0,0,12,6">
                                <TextBlock Text="정렬" Style="{StaticResource FieldLabel}" />
                                <StackPanel Orientation="Horizontal"><ComboBox x:Name="OrderBox" Width="120" Margin="0,0,4,0" /><ComboBox x:Name="OrderDirBox" Width="80" /></StackPanel>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,6">
                                <TextBlock Text="결과에 보일 능력치 4개" Style="{StaticResource FieldLabel}" />
                                <StackPanel Orientation="Horizontal"><ComboBox x:Name="Col1" Width="100" Margin="0,0,4,0" /><ComboBox x:Name="Col2" Width="100" Margin="0,0,4,0" /><ComboBox x:Name="Col3" Width="100" Margin="0,0,4,0" /><ComboBox x:Name="Col4" Width="100" /></StackPanel>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,6,0,0" TextWrapping="Wrap" />
        <DataGrid x:Name="Results" MouseDoubleClick="OnOpenPlayer" ToolTip="두 번 누르면 공식 데이터센터 선수 페이지가 열립니다" />
    </DockPanel>
</UserControl>
