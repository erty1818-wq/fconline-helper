<UserControl x:Class="FcHelper.App.Studio.SquadPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:studio="clr-namespace:FcHelper.App.Studio"
             xmlns:app="clr-namespace:FcHelper.App">
    <DockPanel>
        <!-- Request -->
        <Border DockPanel.Dock="Top" Style="{StaticResource CardPanel}" Margin="0,0,0,10">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <Button x:Name="BuildButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="AI 추천 스쿼드" Click="OnBuild"
                            ToolTip="4가지 방식(최강·균형·가성비·랭커픽)으로 짜서 비교합니다. 🔒 고정한 선수는 그대로 둡니다." />
                    <ToggleButton x:Name="ConditionsToggle" DockPanel.Dock="Right" Style="{StaticResource Chip}" Content="조건 접기" IsChecked="True"
                                  Margin="0,0,10,0" VerticalAlignment="Center" Click="OnToggleConditions" ToolTip="조건을 접으면 피치가 커집니다" />
                    <StackPanel>
                        <TextBlock Text="스쿼드 메이커" Style="{StaticResource H1}" />
                        <TextBlock Style="{StaticResource Hint}" Text="AI 추천을 받아 고치거나, 빈 스쿼드에서 직접 짜거나, 일부만 넣고 나머지를 AI로 채울 수 있습니다." />
                    </StackPanel>
                </DockPanel>
                <StackPanel x:Name="Conditions">
                <WrapPanel>
                    <StackPanel Margin="0,0,14,6">
                        <TextBlock Text="포메이션" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="FormationBox" MinWidth="120" />
                    </StackPanel>
                    <StackPanel Margin="0,0,14,6">
                        <TextBlock Text="예산 (예: 100억)" Style="{StaticResource FieldLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="BudgetBox" Width="110" Text="100억" />
                            <Button Style="{StaticResource Ghost}" Content="10억" Margin="4,0,0,0" Padding="7,3" Click="OnBudgetChip" />
                            <Button Style="{StaticResource Ghost}" Content="50억" Margin="4,0,0,0" Padding="7,3" Click="OnBudgetChip" />
                            <Button Style="{StaticResource Ghost}" Content="100억" Margin="4,0,0,0" Padding="7,3" Click="OnBudgetChip" />
                            <Button Style="{StaticResource Ghost}" Content="500억" Margin="4,0,0,0" Padding="7,3" Click="OnBudgetChip" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Margin="0,0,14,6">
                        <TextBlock Text="급여 한도 (비우면 없음)" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="CapBox" Width="90" ToolTip="공식 스쿼드메이커의 급여 한도를 자동으로 넣습니다 (주 1회 확인)" />
                    </StackPanel>
                    <StackPanel Margin="0,0,14,6">
                        <TextBlock Text="강화 단계 (여러 개면 자동 선택)" Style="{StaticResource FieldLabel}" />
                        <WrapPanel x:Name="GradeChips" />
                    </StackPanel>
                    <StackPanel Margin="0,0,14,6">
                        <TextBlock Text="소속 팀컬러 (11명 모두 해당 선수로, 랭커 인기 20)" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="TeamColorBox" MinWidth="170" DisplayMemberPath="Label" SelectionChanged="OnTeamColorChanged" />
                    </StackPanel>
                    <StackPanel Margin="0,0,14,6">
                        <TextBlock Text="특성 팀컬러 (해당 카드만 보너스)" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="FeatureBox" MinWidth="170" DisplayMemberPath="Label" />
                    </StackPanel>
                    <StackPanel Margin="0,0,14,6">
                        <TextBlock Text="랭커 기준" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="RankBox" MinWidth="120" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,6" VerticalAlignment="Bottom">
                        <CheckBox x:Name="RankerOnlyBox" Content="랭커가 쓰는 카드만" Margin="0,0,0,4" />
                        <CheckBox x:Name="AllocBox" Content="랭커 가격·급여 분배 따르기" IsChecked="True" Margin="0,0,0,6"
                                  ToolTip="상위 랭커 100명의 최근 스쿼드(시세 10억 이상)에서 포지션별 가격 비중·급여의 평균과 10~90% 범위를 구해, 그 범위 안에서 짭니다. 공격수에 돈을 쓰는 랭커 방식입니다." />
                    </StackPanel>
                </WrapPanel>
                </StackPanel>
                <TextBlock x:Name="LockInfo" Style="{StaticResource Hint}" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="Status" DockPanel.Dock="Top" Foreground="{StaticResource Warn}" Margin="0,0,0,6" />

        <!-- Pitch on the left at full height (like the official squad maker); plans, library and the slot panel on the right. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <DockPanel Margin="0,0,12,0">
                <!-- Tools and totals of the eleven -->
                <Border DockPanel.Dock="Top" Style="{StaticResource CardPanel}" Padding="12,8" Margin="0,0,0,8">
                    <StackPanel>
                        <WrapPanel>
                            <Button Style="{StaticResource Ghost}" Content="빈 스쿼드로 직접 짜기" Click="OnNewSquad" Padding="10,4" Margin="0,0,6,4" />
                            <Button x:Name="FillButton" Style="{StaticResource Ghost}" Content="빈 자리 AI로 채우기" Click="OnFillEmpty" Padding="10,4" Margin="0,0,6,4"
                                    ToolTip="지금 들어 있는 선수는 모두 두고, 빈 자리만 예산·급여·팀컬러에 맞춰 채웁니다." />
                            <Button x:Name="UndoButton" Style="{StaticResource Ghost}" Content="↶ 되돌리기" Click="OnUndo" Padding="10,4" Margin="0,0,6,4" IsEnabled="False" ToolTip="Ctrl + Z" />
                            <Button Style="{StaticResource Ghost}" Content="이미지로 저장" Click="OnSaveImage" Padding="10,4" Margin="0,0,14,4" ToolTip="피치와 합계를 PNG로 사진 폴더(FcHelper)에 저장" />
                            <TextBlock Text="전체 강화" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,2,4" />
                            <StackPanel x:Name="BulkGrades" Orientation="Horizontal" Margin="0,0,14,4" />
                            <TextBlock Text="확대" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,6,4" />
                            <Slider x:Name="ZoomSlider" Minimum="1" Maximum="2.5" Value="1" Width="110" VerticalAlignment="Center" Margin="0,0,6,4"
                                    SmallChange="0.1" LargeChange="0.25" ValueChanged="OnZoomChanged" ToolTip="Ctrl + 마우스 휠로도 확대·축소" />
                            <TextBlock x:Name="ZoomText" Text="100%" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,0,4" />
                        </WrapPanel>
                        <TextBlock x:Name="Totals" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <TextBlock x:Name="TeamColorsLine" Style="{StaticResource Hint}" Foreground="{StaticResource Accent}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Grid>
                    <!-- The pitch fills the space; zoomed in, it grows past it and scrolls (Ctrl + wheel). -->
                    <ScrollViewer x:Name="PitchScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="OnPitchWheel" SizeChanged="OnPitchAreaChanged">
                        <studio:PitchView x:Name="Pitch" />
                    </ScrollViewer>
                    <Border x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{StaticResource Panel}"
                            BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="24,18" MaxWidth="420">
                        <StackPanel>
                            <Image Source="{app:Skin empty}" MaxHeight="120" Margin="0,0,0,8" />
                            <TextBlock Text="[AI 추천 스쿼드] 또는 [빈 스쿼드로 직접 짜기]" FontSize="15" HorizontalAlignment="Center" />
                            <TextBlock Style="{StaticResource Hint}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="AI는 최강 · 균형 · 가성비 · 랭커픽 4가지 안을 비교합니다. 고른 안은 선수마다 바꾸거나 강화를 고칠 수 있습니다." />
                        </StackPanel>
                    </Border>
                </Grid>
            </DockPanel>

            <DockPanel Grid.Column="1">
                <!-- AI plans: 2 × 2 -->
                <ListBox x:Name="Modes" DockPanel.Dock="Top" Background="Transparent" BorderThickness="0" SelectionChanged="OnModeSelected"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,6">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,6,6" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="B" Background="{StaticResource PanelSheen}" BorderBrush="{StaticResource PanelEdge}" BorderThickness="1" CornerRadius="10" Padding="11,8">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Muted}" /></Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                <Setter TargetName="B" Property="Background" Value="{StaticResource Raised}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Background="{StaticResource AccentSoft}">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Badge}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Badge}" FontSize="10" Foreground="{StaticResource Accent}" />
                                    </Border>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" />
                                </DockPanel>
                                <TextBlock Text="{Binding Total}" Style="{StaticResource BigNumber}" FontSize="20" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding Ovr}" Style="{StaticResource Hint}" Foreground="{StaticResource Text}" />
                                <TextBlock Text="{Binding Effective}" Style="{StaticResource Hint}" />
                                <TextBlock Text="{Binding TeamColor}" Style="{StaticResource Hint}" Foreground="{StaticResource Accent}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Squad library -->
                <Border DockPanel.Dock="Top" Style="{StaticResource CardPanel}" Padding="10,8" Margin="0,0,6,8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="보관함" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <WrapPanel>
                            <TextBox x:Name="LibraryName" Width="110" Margin="0,0,4,2" ToolTip="저장할 스쿼드 이름 (비우면 날짜)" />
                            <Button Style="{StaticResource Ghost}" Content="저장" Click="OnLibrarySave" Padding="9,3" Margin="0,0,8,2" />
                            <ComboBox x:Name="LibraryBox" MinWidth="110" Margin="0,0,4,2" />
                            <Button Style="{StaticResource Ghost}" Content="열기" Click="OnLibraryLoad" Padding="9,3" Margin="0,0,4,2" />
                            <Button Style="{StaticResource Ghost}" Content="삭제" Click="OnLibraryDelete" Padding="9,3" Margin="0,0,0,2" />
                        </WrapPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource CardPanel}" Margin="0,0,6,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="Detail">
                            <TextBlock Text="선수나 빈 자리(+)를 누르면 여기서 바꾸고, 대체 선수를 보고, 검색할 수 있습니다." Style="{StaticResource Hint}" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
