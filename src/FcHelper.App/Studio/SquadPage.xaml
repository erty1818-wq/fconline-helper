<UserControl x:Class="FcHelper.App.Studio.SquadPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:studio="clr-namespace:FcHelper.App.Studio"
             xmlns:app="clr-namespace:FcHelper.App">
    <DockPanel>
        <!-- Request -->
        <Border x:Name="RequestBorder" DockPanel.Dock="Top" Style="{StaticResource CardPanel}" Margin="0,0,0,10">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <Button x:Name="BuildButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="AI 추천 스쿼드" Click="OnBuild"
                            ToolTip="4가지 방식(최강·균형·가성비·랭커픽)으로 짜서 비교합니다. 고정한 선수는 그대로 둡니다." />
                    <ToggleButton x:Name="ConditionsToggle" DockPanel.Dock="Right" Style="{StaticResource Chip}" Content="조건 접기" IsChecked="True"
                                  Margin="0,0,10,0" VerticalAlignment="Center" Click="OnToggleConditions" ToolTip="조건을 접으면 피치가 커집니다" />
                    <StackPanel>
                        <TextBlock Text="스쿼드 메이커" Style="{StaticResource H1}" />
                        <TextBlock x:Name="MakerHint" Style="{StaticResource Hint}" Text="AI 추천을 받아 고치거나, 빈 스쿼드에서 직접 짜거나, 일부만 넣고 나머지를 AI로 채울 수 있습니다." />
                    </StackPanel>
                </DockPanel>
                <StackPanel x:Name="Conditions">
                <WrapPanel>
                    <StackPanel Margin="0,0,14,6">
                        <TextBlock Text="예산 (예: 100억)" Style="{StaticResource FieldLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="BudgetBox" Width="110" Text="100억" />
                            <Button Style="{StaticResource Ghost}" Content="10억" Margin="4,0,0,0" Padding="7,3" Click="OnBudgetChip" />
                            <Button Style="{StaticResource Ghost}" Content="50억" Margin="4,0,0,0" Padding="7,3" Click="OnBudgetChip" />
                            <Button Style="{StaticResource Ghost}" Content="100억" Margin="4,0,0,0" Padding="7,3" Click="OnBudgetChip" />
                            <Button Style="{StaticResource Ghost}" Content="500억" Margin="4,0,0,0" Padding="7,3" Click="OnBudgetChip" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Margin="0,0,14,6">
                        <TextBlock Text="급여 한도 (비우면 없음)" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="CapBox" Width="90" ToolTip="공식 스쿼드메이커의 급여 한도를 자동으로 넣습니다 (주 1회 확인)" />
                    </StackPanel>
                    <StackPanel Margin="0,0,14,6">
                        <TextBlock Text="강화 단계 (여러 개면 자동 선택)" Style="{StaticResource FieldLabel}" />
                        <WrapPanel x:Name="GradeChips" />
                    </StackPanel>
                    <StackPanel Margin="0,0,14,6">
                        <TextBlock Text="소속 팀컬러 (11명 모두 해당 선수로, 랭커 인기 20)" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="TeamColorBox" MinWidth="170" DisplayMemberPath="Label" SelectionChanged="OnTeamColorChanged" />
                    </StackPanel>
                    <StackPanel Margin="0,0,14,6">
                        <TextBlock Text="특성 팀컬러 (해당 카드만 보너스)" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="FeatureBox" MinWidth="170" DisplayMemberPath="Label" />
                    </StackPanel>
                    <StackPanel Margin="0,0,14,6">
                        <TextBlock Text="랭커 기준" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="RankBox" MinWidth="120" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,6" VerticalAlignment="Bottom">
                        <CheckBox x:Name="RankerOnlyBox" Content="랭커가 쓰는 카드만" Margin="0,0,0,4" />
                        <CheckBox x:Name="AllocBox" Content="랭커 가격·급여 분배 따르기" IsChecked="True" Margin="0,0,0,6"
                                  ToolTip="상위 랭커 100명의 최근 스쿼드(시세 10억 이상)에서 포지션별 가격 비중·급여의 평균과 10~90% 범위를 구해, 그 범위 안에서 짭니다. 공격수에 돈을 쓰는 랭커 방식입니다." />
                    </StackPanel>
                </WrapPanel>
                </StackPanel>
                <TextBlock x:Name="LockInfo" Style="{StaticResource Hint}" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="Status" DockPanel.Dock="Top" Foreground="{StaticResource Warn}" Margin="0,0,0,6" />

        <!-- Pitch on the left at full height (like the official squad maker); plans, library and the slot panel on the right. -->
        <Grid x:Name="MainGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition x:Name="SplitterColumn" Width="12" />
                <ColumnDefinition x:Name="SideColumn" Width="400" MinWidth="300" MaxWidth="720" />
            </Grid.ColumnDefinitions>

            <!-- Drag to give the pitch or the side panel more room. -->
            <GridSplitter x:Name="MainSplitter" Grid.Column="1" Width="12" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"
                          ResizeBehavior="PreviousAndNext" ToolTip="끌어서 피치와 오른쪽 칸 크기 조절" />
            <Border x:Name="SplitterBar" Grid.Column="1" Width="3" CornerRadius="2" Background="{StaticResource Line}" Height="48" IsHitTestVisible="False" />

            <DockPanel x:Name="PitchDock">
                <!-- Tools and totals of the eleven -->
                <!-- Kept to a few short lines: every pixel left goes to the pitch. -->
                <Border x:Name="ToolsBorder" DockPanel.Dock="Top" Style="{StaticResource CardPanel}" Padding="10,6" Margin="0,0,0,6">
                    <StackPanel>
                        <WrapPanel>
                            <StackPanel x:Name="NormalFormationHost" Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox x:Name="FormationBox" MinWidth="96" Margin="0,0,8,4" VerticalAlignment="Center" />
                                <TextBlock x:Name="FormationName" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,12,4" />
                            </StackPanel>
                            <Button Style="{StaticResource Ghost}" Content="빈 스쿼드" Click="OnNewSquad" Padding="9,3" Margin="0,0,5,4" ToolTip="빈 스쿼드로 직접 짜기" />
                            <Button x:Name="FillButton" Style="{StaticResource Ghost}" Content="빈 자리 AI" Click="OnFillEmpty" Padding="9,3" Margin="0,0,5,4"
                                    ToolTip="지금 들어 있는 선수는 모두 두고, 빈 자리만 예산·급여·팀컬러에 맞춰 AI로 채웁니다." />
                            <Button x:Name="UndoButton" Style="{StaticResource Ghost}" Click="OnUndo" Padding="8,4" Margin="0,0,5,4" IsEnabled="False" ToolTip="되돌리기 (Ctrl + Z)">
                                <Image Source="{app:Icon Undo}" Width="16" Height="16" />
                            </Button>
                            <Button x:Name="FocusButton" Style="{StaticResource Ghost}" Click="OnToggleFocus" Padding="9,3" Margin="0,0,5,4" ToolTip="전체 화면으로 피치 보기 (F11)">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{app:Icon Fullscreen}" Width="16" Height="16" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="크게 보기" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Ghost}" Click="OnSaveImage" Padding="9,3" Margin="0,0,12,4" ToolTip="피치와 합계를 PNG로 사진 폴더(FcHelper)에 저장">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{app:Icon Image}" Width="16" Height="16" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="저장" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="전체 강화" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,2,4" />
                            <StackPanel x:Name="BulkGrades" Orientation="Horizontal" Margin="0,0,12,4" />
                            <!-- What the in-game OVR on the cards includes -->
                            <TextBlock Text="적응도" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,6,4" />
                            <ComboBox x:Name="AdaptBox" Width="62" Margin="0,0,14,4" SelectionChanged="OnFinalOptionChanged"
                                      ToolTip="팀 적응도: 모든 능력치 +1 ~ +5 (데이터센터 기본값은 +1)" />
                            <CheckBox x:Name="TrainingToggle" Content="집중훈련 최대 반영" Margin="0,0,14,4" VerticalAlignment="Center" Click="OnFinalOptionChanged"
                                      ToolTip="포지션 가중치가 가장 큰 스탯 5개(+11부터 6개)를 +2씩 올렸을 때의 OVR" />
                            <CheckBox x:Name="FacesToggle" Content="미니페이스" Margin="0,0,0,4" VerticalAlignment="Center" Click="OnFacesToggle" IsChecked="True"
                                      ToolTip="선수 사진 표시 (선수를 누르면 시즌별 사진이나 내 이미지로 바꿀 수 있습니다)" />
                        </WrapPanel>
                        <TextBlock x:Name="Totals" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        <TextBlock x:Name="TeamColorsLine" Style="{StaticResource Hint}" Foreground="{StaticResource Accent}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    </StackPanel>
                </Border>
                <!-- A small note above the pitch, not over it (the empty slots already show where to click); ✕ or any slot click closes it. -->
                <Border x:Name="EmptyState" DockPanel.Dock="Top" HorizontalAlignment="Center" Background="{StaticResource Panel}" Opacity="0.96"
                        BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="14,8,8,8" Margin="0,0,0,6" MaxWidth="560">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Click="OnCloseHint" Padding="7,2" Margin="10,0,0,0"
                                VerticalAlignment="Top" ToolTip="안내 닫기">
                            <Image Source="{app:Icon Close}" Width="12" Height="12" />
                        </Button>
                        <StackPanel>
                            <TextBlock Text="빈 자리(+)를 눌러 선수를 넣거나, 위의 [AI 추천 스쿼드]를 누르세요" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0" TextWrapping="Wrap"
                                       Text="AI는 최강 · 균형 · 가성비 · 랭커픽 4가지 안을 비교합니다. 카드를 끌어서 포지션을 바꿀 수도 있습니다." />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Grid x:Name="PitchHost">
                    <studio:PitchView x:Name="Pitch" HorizontalAlignment="Center" VerticalAlignment="Center" />

                    <!-- Focus mode overlay -->
                    <!-- Left floating panel -->
                    <Border x:Name="FocusPanel" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20"
                            Background="{StaticResource Panel}" Opacity="0.95" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" CornerRadius="12" Padding="14,12" Visibility="Collapsed" MaxWidth="340">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Click="OnExitFocus" Padding="8,3">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{app:Icon Close}" Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="나가기 (Esc)" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="FocusCollapseBtn" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Margin="0,0,6,0" Padding="6,3" Click="OnToggleFocusCollapse" ToolTip="패널 접기/펼치기">
                                    <Image x:Name="FocusCollapseImg" Source="{app:Icon ChevronLeft}" Width="12" Height="12" />
                                </Button>
                                <TextBlock Text="스쿼드" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <StackPanel x:Name="FocusPanelBody">
                                <WrapPanel x:Name="FocusFormationHost" Margin="0,0,0,8" VerticalAlignment="Center" />
                                <TextBlock x:Name="FocusTotals" FontWeight="SemiBold" Margin="0,2,0,4" TextWrapping="Wrap" />
                                <TextBlock x:Name="FocusTeamColors" Style="{StaticResource Hint}" Foreground="{StaticResource Accent}" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Right slide-out drawer -->
                    <Border x:Name="FocusDrawer" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="400"
                            Background="{StaticResource Panel}" Opacity="0.97" BorderBrush="{StaticResource Line}"
                            BorderThickness="1,0,0,0" Padding="16,14" Visibility="Collapsed">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Click="OnCloseDrawer" Padding="8,3">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{app:Icon Close}" Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="닫기" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="선수 상세" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border x:Name="FocusDrawerHost" />
                        </DockPanel>
                    </Border>
                </Grid>
            </DockPanel>

            <DockPanel x:Name="SideDock" Grid.Column="2">
                <!-- AI plans: 2 × 2 -->
                <ListBox x:Name="Modes" DockPanel.Dock="Top" Background="Transparent" BorderThickness="0" SelectionChanged="OnModeSelected"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,6">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,6,6" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="B" Background="{StaticResource PanelSheen}" BorderBrush="{StaticResource PanelEdge}" BorderThickness="1" CornerRadius="10" Padding="10,6"
                                                ToolTip="{Binding Details}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Muted}" /></Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                <Setter TargetName="B" Property="Background" Value="{StaticResource Raised}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Background="{StaticResource AccentSoft}">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Badge}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Badge}" FontSize="10" Foreground="{StaticResource Accent}" />
                                    </Border>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" />
                                </DockPanel>
                                <TextBlock Text="{Binding Total}" Style="{StaticResource BigNumber}" FontSize="18" Margin="0,1,0,0" />
                                <TextBlock Text="{Binding Ovr}" Style="{StaticResource Hint}" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Squad library -->
                <Border x:Name="LibraryBorder" DockPanel.Dock="Top" Style="{StaticResource CardPanel}" Padding="8,5" Margin="0,0,6,6">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="보관함" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Click="OnLibraryDelete" Padding="7,2" ToolTip="고른 스쿼드 삭제">
                            <Image Source="{app:Icon Close}" Width="12" Height="12" />
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="열기" Click="OnLibraryLoad" Padding="8,2" Margin="0,0,4,0" />
                        <ComboBox x:Name="LibraryBox" DockPanel.Dock="Right" Width="96" Margin="0,0,4,0" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="저장" Click="OnLibrarySave" Padding="8,2" Margin="0,0,8,0" />
                        <TextBox x:Name="LibraryName" ToolTip="저장할 스쿼드 이름 (비우면 날짜)" Margin="0,0,4,0" />
                    </DockPanel>
                </Border>

                <Border x:Name="SideDetailHost" Style="{StaticResource CardPanel}" Margin="0,0,6,0">
                    <ScrollViewer x:Name="DetailScroller" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="Detail">
                            <TextBlock Text="선수나 빈 자리(+)를 누르면 여기서 바꾸고, 대체 선수를 보고, 검색할 수 있습니다." Style="{StaticResource Hint}" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
