<UserControl x:Class="FcHelper.App.Studio.MySquadPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:market="clr-namespace:FcHelper.Market;assembly=FcHelper.Market"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:studio="clr-namespace:FcHelper.App.Studio">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource CardPanel}" Margin="0,0,0,10">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <Button x:Name="LoadButton" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="내 스쿼드 불러오기" Click="OnLoad" />
                    <StackPanel>
                        <TextBlock Text="내 스쿼드 업그레이드" Style="{StaticResource H1}" />
                        <TextBlock x:Name="Who" Style="{StaticResource Hint}" Text="최근 공식경기의 선발 11명과 강화 단계를 불러옵니다." />
                    </StackPanel>
                </DockPanel>
                <WrapPanel>
                    <StackPanel Margin="0,0,14,0"><TextBlock Text="예산 (억, 판매 대금 포함 순비용)" Style="{StaticResource FieldLabel}" /><TextBox x:Name="BudgetBox" Width="110" Text="10" ToolTip="{x:Static market:Bp.InputHint}" /></StackPanel>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock x:Name="FeeLabel" Text="판매 수수료 40%" Style="{StaticResource FieldLabel}" />
                        <WrapPanel>
                            <ToggleButton x:Name="PcRoomChip" Style="{StaticResource Chip}" Content="PC방" Click="OnFeeChanged" ToolTip="수수료 30% 할인 (TOP CLASS와 함께면 50%)" />
                            <ToggleButton x:Name="TopClassChip" Style="{StaticResource Chip}" Content="TOP CLASS" Click="OnFeeChanged" ToolTip="수수료 20% 할인" />
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0"><TextBlock Text="할인 쿠폰 %" Style="{StaticResource FieldLabel}" /><TextBox x:Name="CouponBox" Width="60" Text="0" TextChanged="OnFeeChanged" /></StackPanel>
                    <StackPanel Margin="0,0,14,0"><TextBlock Text="쿠폰 최대 할인 (억)" Style="{StaticResource FieldLabel}" /><TextBox x:Name="CouponMaxBox" Width="80" ToolTip="쿠폰의 카드당 최대 할인, 억 단위 (예: 0.5 = 0.5억). 비우면 제한 없음" TextChanged="OnFeeChanged" /></StackPanel>
                    <StackPanel Margin="0,0,14,0"><TextBlock Text="유지할 팀컬러 (단계가 내려가는 교체 제외)" Style="{StaticResource FieldLabel}" /><WrapPanel x:Name="TeamColorChips" MinHeight="28" /></StackPanel>
                    <Button x:Name="FindButton" Style="{StaticResource Primary}" Content="교체 추천" VerticalAlignment="Bottom" Click="OnFind" />
                </WrapPanel>
            </StackPanel>
        </Border>
        <TextBlock x:Name="Status" DockPanel.Dock="Top" Foreground="{StaticResource Muted}" Margin="0,0,0,6" TextWrapping="Wrap" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>
            <studio:PitchView x:Name="Pitch" Margin="0,0,12,0" />
            <Border Grid.Column="1" Style="{StaticResource CardPanel}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="효과 큰 교체 (환산 OVR 증가 [추정])" Style="{StaticResource H2}" />
                    <ListBox x:Name="Plans" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}" SelectionChanged="OnPlanSelected"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
