<Window x:Class="FcHelper.App.Studio.StudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:FcHelper.App"
        Title="스쿼드·시세 · FC Online Helper" Width="1320" Height="860" MinWidth="1000" MinHeight="620"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen" FontFamily="Malgun Gothic, Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="208" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Navigation rail -->
        <Border Grid.RowSpan="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,18">
                    <Image Source="{app:Skin logo}" Width="30" Height="30" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="스쿼드·시세" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="FC Online Helper" Style="{StaticResource Hint}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock x:Name="DataStatus" Style="{StaticResource Hint}" Margin="4,0,4,8" />
                    <Button x:Name="RefreshButton" Style="{StaticResource Ghost}" Content="시세 지금 갱신" Click="OnRefresh" />
                </StackPanel>
                <StackPanel x:Name="Nav" />
            </DockPanel>
        </Border>

        <!-- Page -->
        <ContentControl x:Name="Host" Grid.Column="1" Margin="20,16,20,8" Focusable="False" />

        <TextBlock Grid.Column="1" Grid.Row="1" Margin="20,0,20,10" Style="{StaticResource Hint}"
                   Text="Data based on NEXON Open API · 시세·랭커 데이터: FC온라인 데이터센터 · [추정] 표시는 계산으로 만든 값입니다." />
    </Grid>
</Window>
