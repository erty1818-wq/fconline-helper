<Window x:Class="FcHelper.App.Studio.CardDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:market="clr-namespace:FcHelper.Market;assembly=FcHelper.Market"
        xmlns:studio="clr-namespace:FcHelper.App.Studio"
        Title="선수 정보 · FC Online Helper" Width="1320" Height="860" MinWidth="1000" MinHeight="620"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <DataTemplate x:Key="PickCell">
            <CheckBox IsChecked="{Binding Picked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"
                      ToolTip="체크하면 아래 [스쿼드 만들기]에 함께 넣습니다." />
        </DataTemplate>
        <DataTemplate x:Key="FaceCell">
            <Image Width="30" Height="30" studio:Pictures.FaceOf="{Binding SpId}" RenderOptions.BitmapScalingMode="HighQuality" />
        </DataTemplate>
    </Window.Resources>
    <DockPanel Margin="16,14,16,10">
        <!-- Who: face, name, the card's fixed facts and its prices -->
        <Border DockPanel.Dock="Top" Style="{StaticResource CardPanel}" Margin="0,0,0,10">
            <DockPanel>
                <Image x:Name="Face" DockPanel.Dock="Left" Width="84" Height="84" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel DockPanel.Dock="Right" Margin="14,0,0,0" Orientation="Horizontal">
                    <StackPanel Margin="0,0,12,0" MinWidth="150">
                        <TextBlock Text="즐겨찾기 · 목표가 (억)" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="TargetBox" Margin="0,0,0,8" ToolTip="{x:Static market:Bp.InputHint}" />
                        <Button x:Name="FavoriteButton" Style="{StaticResource Ghost}" Content="즐겨찾기 추가" Click="OnFavorite"
                                ToolTip="목표가를 넣으면 시세 갱신 때 그 아래로 내려온 카드를 트레이 알림으로 알려 줍니다. 비워 두면 목록에만 넣습니다." />
                    </StackPanel>
                    <StackPanel MinWidth="130">
                        <TextBlock Text="강화" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="GradeBox" SelectionChanged="OnGrade" Margin="0,0,0,8" />
                        <Button Style="{StaticResource Ghost}" Content="데이터센터 열기" Click="OnOfficial" ToolTip="공식 데이터센터의 이 카드 페이지를 브라우저로 엽니다." />
                    </StackPanel>
                </StackPanel>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Image x:Name="SeasonIcon" Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock x:Name="NameText" Style="{StaticResource H1}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="FactsText" Margin="0,6,0,0" Foreground="{StaticResource Text}" TextWrapping="Wrap" />
                    <TextBlock x:Name="PositionsText" Margin="0,4,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                    <TextBlock x:Name="PriceText" Margin="0,6,0,0" Foreground="{StaticResource Text}" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>
        <!-- Build a squad from what is checked -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button x:Name="BuildButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="이 선수로 스쿼드 만들기" Click="OnBuildSquad"
                    ToolTip="이 선수와 체크한 선수를 고정하고, 나머지 자리는 AI가 채웁니다. 고른 팀컬러도 함께 넘깁니다." />
            <TextBlock x:Name="Status" Foreground="{StaticResource Muted}" Margin="0,0,12,0" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- Detailed stats -->
            <Border Style="{StaticResource CardPanel}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="세부 능력치" Style="{StaticResource H2}" />
                    <TextBlock x:Name="StatsHint" DockPanel.Dock="Top" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,2,0,8" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="StatsPanel" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <ToggleButton x:Name="ColorsTab" Style="{StaticResource Chip}" Content="팀컬러 · 같이 쓸 선수" IsChecked="True" Click="OnTab" Checked="OnTab" />
                        <ToggleButton x:Name="RankersTab" Style="{StaticResource Chip}" Content="랭커 사용" Click="OnTab" Checked="OnTab" />
                        <ToggleButton x:Name="WhyTab" Style="{StaticResource Chip}" Content="왜 이 가격?" Click="OnTab" Checked="OnTab" />
                        <ToggleButton x:Name="SimilarTab" Style="{StaticResource Chip}" Content="비슷하고 더 싼 카드" Click="OnTab" Checked="OnTab" />
                        <ToggleButton x:Name="GraphTab" Style="{StaticResource Chip}" Content="시세 그래프" Click="OnTab" Checked="OnTab" />
                        <ToggleButton x:Name="OthersTab" Style="{StaticResource Chip}" Content="이 선수의 다른 카드" Click="OnTab" Checked="OnTab" />
                    </WrapPanel>
                    <Grid>
                        <DockPanel x:Name="ColorsPanel">
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="팀컬러를 누르면 같이 쓰기 좋은 선수가 나옵니다. 랭커가 실제로 많이 쓴 카드 먼저, 그다음 예상가보다 싼 순서입니다 [추정]. 체크한 선수는 스쿼드에 함께 넣습니다." />
                            <WrapPanel x:Name="ColorChips" DockPanel.Dock="Top" Margin="0,0,0,6" />
                            <TextBlock x:Name="ColorEffects" DockPanel.Dock="Top" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <DataGrid x:Name="Partners" MouseDoubleClick="OnOpenRow" ToolTip="두 번 누르면 그 선수 정보를 엽니다.">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="34" CellTemplate="{StaticResource PickCell}" />
                                    <DataGridTextColumn Header="역할" Binding="{Binding Role}" Width="84" />
                                    <DataGridTemplateColumn Header="" Width="40" CellTemplate="{StaticResource FaceCell}" />
                                    <DataGridTextColumn Header="선수" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="시즌" Binding="{Binding Season}" Width="82" />
                                    <DataGridTextColumn Header="OVR" Binding="{Binding Ovr}" Width="50" />
                                    <DataGridTextColumn Header="급여" Binding="{Binding Pay}" Width="42" />
                                    <DataGridTextColumn Header="시세" Binding="{Binding Price}" Width="72" ElementStyle="{StaticResource Num}" />
                                    <DataGridTextColumn Header="예상가 [추정]" Binding="{Binding Expected}" Width="72" ElementStyle="{StaticResource Num}" />
                                    <DataGridTextColumn Header="차이" Binding="{Binding Diff}" Width="60" ElementStyle="{StaticResource Num}" />
                                    <DataGridTextColumn Header="랭커" Binding="{Binding Rankers}" Width="44" ElementStyle="{StaticResource Num}" />
                                    <DataGridTextColumn Header="특성" Binding="{Binding Traits}" Width="125" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                        <DockPanel x:Name="RankersPanel" Visibility="Collapsed">
                            <TextBlock x:Name="RankersText" DockPanel.Dock="Top" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <TextBlock DockPanel.Dock="Top" Text="이 카드와 같이 쓴 카드" Style="{StaticResource H2}" Margin="0,4,0,4" />
                            <DataGrid x:Name="Teammates" MouseDoubleClick="OnOpenRow" ToolTip="두 번 누르면 그 선수 정보를 엽니다.">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="34" CellTemplate="{StaticResource PickCell}" />
                                    <DataGridTemplateColumn Header="" Width="40" CellTemplate="{StaticResource FaceCell}" />
                                    <DataGridTextColumn Header="선수" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="시즌" Binding="{Binding Season}" Width="80" />
                                    <DataGridTextColumn Header="강화" Binding="{Binding Grade}" Width="50" />
                                    <DataGridTextColumn Header="OVR" Binding="{Binding Ovr}" Width="50" />
                                    <DataGridTextColumn Header="시세" Binding="{Binding Price}" Width="80" ElementStyle="{StaticResource Num}" />
                                    <DataGridTextColumn Header="같이 쓴 팀" Binding="{Binding Together}" Width="70" ElementStyle="{StaticResource Num}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                        <DockPanel x:Name="WhyPanel" Visibility="Collapsed">
                            <TextBlock x:Name="WhyHeader" DockPanel.Dock="Top" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <TextBlock x:Name="WhyFooter" DockPanel.Dock="Bottom" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <DataGrid x:Name="WhyRows">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="이유" Binding="{Binding Label}" Width="220" />
                                    <DataGridTextColumn Header="가격 영향" Binding="{Binding Percent}" Width="90" ElementStyle="{StaticResource Num}" />
                                    <DataGridTextColumn Header="이 몫까지 쌓은 값" Binding="{Binding Running}" Width="120" ElementStyle="{StaticResource Num}" />
                                    <DataGridTextColumn Header="설명" Binding="{Binding Detail}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                        <DockPanel x:Name="SimilarPanel" Visibility="Collapsed">
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="같은 역할에 OVR이 비슷하거나 높으면서 이 카드보다 싼 카드입니다. 같은 특성 먼저, OVR 높은 순, 싼 순입니다. 체감까지 같다는 뜻은 아닙니다." />
                            <DataGrid x:Name="SimilarRows" MouseDoubleClick="OnOpenRow" ToolTip="두 번 누르면 그 선수 정보를 엽니다.">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="34" CellTemplate="{StaticResource PickCell}" />
                                    <DataGridTemplateColumn Header="" Width="40" CellTemplate="{StaticResource FaceCell}" />
                                    <DataGridTextColumn Header="선수" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="시즌" Binding="{Binding Season}" Width="82" />
                                    <DataGridTextColumn Header="OVR" Binding="{Binding Ovr}" Width="50" />
                                    <DataGridTextColumn Header="급여" Binding="{Binding Pay}" Width="42" />
                                    <DataGridTextColumn Header="시세" Binding="{Binding Price}" Width="72" ElementStyle="{StaticResource Num}" />
                                    <DataGridTextColumn Header="이 카드보다" Binding="{Binding Cheaper}" Width="74" ElementStyle="{StaticResource Num}" />
                                    <DataGridTextColumn Header="예상가 [추정]" Binding="{Binding Expected}" Width="72" ElementStyle="{StaticResource Num}" />
                                    <DataGridTextColumn Header="특성" Binding="{Binding Traits}" Width="125" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                        <DockPanel x:Name="GraphPanel" Visibility="Collapsed">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="기간" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="RangeBox" MinWidth="90" SelectionChanged="OnRange" />
                                <TextBlock x:Name="GraphText" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Canvas x:Name="Graph" ClipToBounds="True" Background="Transparent" SizeChanged="OnGraphSize" />
                        </DockPanel>
                        <DataGrid x:Name="Others" Visibility="Collapsed" MouseDoubleClick="OnOpenRow" ToolTip="두 번 누르면 그 카드 정보를 엽니다.">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="시즌" Width="110" SortMemberPath="Season">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Width="22" Height="22" studio:Pictures.SeasonOf="{Binding Season}" RenderOptions.BitmapScalingMode="HighQuality" />
                                                <TextBlock Text="{Binding Season}" Margin="4,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="OVR" Binding="{Binding Ovr}" Width="50" />
                                <DataGridTextColumn Header="급여" Binding="{Binding Pay}" Width="46" />
                                <DataGridTextColumn Header="약발" Binding="{Binding WeakFoot}" Width="46" />
                                <DataGridTextColumn Header="시세" Binding="{Binding Price}" Width="80" ElementStyle="{StaticResource Num}" />
                                <DataGridTextColumn Header="랭커" Binding="{Binding Rankers}" Width="50" ElementStyle="{StaticResource Num}" />
                                <DataGridTextColumn Header="특성" Binding="{Binding Traits}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
