<Window x:Class="FcHelper.App.Studio.CardDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:studio="clr-namespace:FcHelper.App.Studio"
        Title="선수 정보 · FC Online Helper" Width="1180" Height="840" MinWidth="960" MinHeight="600"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16,14,16,10">
        <!-- Who: face, name, the card's fixed facts and its prices -->
        <Border DockPanel.Dock="Top" Style="{StaticResource CardPanel}" Margin="0,0,0,10">
            <DockPanel>
                <Image x:Name="Face" DockPanel.Dock="Left" Width="84" Height="84" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel DockPanel.Dock="Right" Margin="14,0,0,0" MinWidth="130">
                    <TextBlock Text="강화" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="GradeBox" SelectionChanged="OnGrade" Margin="0,0,0,8" />
                    <Button Style="{StaticResource Ghost}" Content="데이터센터 열기" Click="OnOfficial" ToolTip="공식 데이터센터의 이 카드 페이지를 브라우저로 엽니다." />
                </StackPanel>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Image x:Name="SeasonIcon" Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock x:Name="NameText" Style="{StaticResource H1}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="FactsText" Margin="0,6,0,0" Foreground="{StaticResource Text}" TextWrapping="Wrap" />
                    <TextBlock x:Name="PositionsText" Margin="0,4,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                    <TextBlock x:Name="PriceText" Margin="0,6,0,0" Foreground="{StaticResource Text}" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>
        <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Foreground="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- Detailed stats -->
            <Border Style="{StaticResource CardPanel}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="세부 능력치" Style="{StaticResource H2}" />
                    <TextBlock x:Name="StatsHint" DockPanel.Dock="Top" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,2,0,8" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="StatsPanel" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <!-- Team colours, rankers, other cards -->
            <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <ToggleButton x:Name="ColorsTab" Style="{StaticResource Chip}" Content="팀컬러 · 같이 쓸 선수" IsChecked="True" Click="OnTab" />
                        <ToggleButton x:Name="RankersTab" Style="{StaticResource Chip}" Content="랭커 사용" Click="OnTab" />
                        <ToggleButton x:Name="OthersTab" Style="{StaticResource Chip}" Content="이 선수의 다른 카드" Click="OnTab" />
                    </StackPanel>
                    <Grid>
                        <DockPanel x:Name="ColorsPanel">
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="팀컬러를 누르면 같이 쓰기 좋은 선수가 나옵니다. 랭커가 실제로 많이 쓴 카드 먼저, 그다음 예상가보다 싼 순서입니다 [추정]." />
                            <WrapPanel x:Name="ColorChips" DockPanel.Dock="Top" Margin="0,0,0,6" />
                            <TextBlock x:Name="ColorEffects" DockPanel.Dock="Top" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <DataGrid x:Name="Partners" MouseDoubleClick="OnOpenRow" ToolTip="두 번 누르면 그 선수 정보를 엽니다.">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="역할" Binding="{Binding Role}" Width="90" />
                                    <DataGridTemplateColumn Header="" Width="40">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate><Image Width="30" Height="30" studio:Pictures.FaceOf="{Binding SpId}" RenderOptions.BitmapScalingMode="HighQuality" /></DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="선수" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="시즌" Binding="{Binding Season}" Width="70" />
                                    <DataGridTextColumn Header="OVR" Binding="{Binding Ovr}" Width="45" />
                                    <DataGridTextColumn Header="급여" Binding="{Binding Pay}" Width="42" />
                                    <DataGridTextColumn Header="시세" Binding="{Binding Price}" Width="72" ElementStyle="{StaticResource Num}" />
                                    <DataGridTextColumn Header="예상가 [추정]" Binding="{Binding Expected}" Width="82" ElementStyle="{StaticResource Num}" />
                                    <DataGridTextColumn Header="차이" Binding="{Binding Diff}" Width="50" ElementStyle="{StaticResource Num}" />
                                    <DataGridTextColumn Header="랭커" Binding="{Binding Rankers}" Width="50" ElementStyle="{StaticResource Num}" />
                                    <DataGridTextColumn Header="특성" Binding="{Binding Traits}" Width="100" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                        <DockPanel x:Name="RankersPanel" Visibility="Collapsed">
                            <TextBlock x:Name="RankersText" DockPanel.Dock="Top" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <TextBlock DockPanel.Dock="Top" Text="이 카드와 같이 쓴 카드" Style="{StaticResource H2}" Margin="0,4,0,4" />
                            <DataGrid x:Name="Teammates" MouseDoubleClick="OnOpenRow" ToolTip="두 번 누르면 그 선수 정보를 엽니다.">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="40">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate><Image Width="30" Height="30" studio:Pictures.FaceOf="{Binding SpId}" RenderOptions.BitmapScalingMode="HighQuality" /></DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="선수" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="시즌" Binding="{Binding Season}" Width="80" />
                                    <DataGridTextColumn Header="강화" Binding="{Binding Grade}" Width="50" />
                                    <DataGridTextColumn Header="OVR" Binding="{Binding Ovr}" Width="50" />
                                    <DataGridTextColumn Header="시세" Binding="{Binding Price}" Width="80" ElementStyle="{StaticResource Num}" />
                                    <DataGridTextColumn Header="같이 쓴 팀" Binding="{Binding Together}" Width="70" ElementStyle="{StaticResource Num}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                        <DataGrid x:Name="Others" Visibility="Collapsed" MouseDoubleClick="OnOpenRow" ToolTip="두 번 누르면 그 카드 정보를 엽니다.">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="시즌" Width="110" SortMemberPath="Season">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Width="22" Height="22" studio:Pictures.SeasonOf="{Binding Season}" RenderOptions.BitmapScalingMode="HighQuality" />
                                                <TextBlock Text="{Binding Season}" Margin="4,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="OVR" Binding="{Binding Ovr}" Width="50" />
                                <DataGridTextColumn Header="급여" Binding="{Binding Pay}" Width="46" />
                                <DataGridTextColumn Header="약발" Binding="{Binding WeakFoot}" Width="46" />
                                <DataGridTextColumn Header="시세" Binding="{Binding Price}" Width="80" ElementStyle="{StaticResource Num}" />
                                <DataGridTextColumn Header="랭커" Binding="{Binding Rankers}" Width="50" ElementStyle="{StaticResource Num}" />
                                <DataGridTextColumn Header="특성" Binding="{Binding Traits}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
