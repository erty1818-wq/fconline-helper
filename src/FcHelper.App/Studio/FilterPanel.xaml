<UserControl x:Class="FcHelper.App.Studio.FilterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Detailed card search shared by 가성비 찾기 and 숨은 랭커픽. -->
    <StackPanel>
        <WrapPanel>
            <StackPanel Margin="0,0,14,6">
                <TextBlock Text="OVR (강화 반영)" Style="{StaticResource FieldLabel}" />
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="MinOvrBox" Width="55" ToolTip="이보다 낮은 카드는 뺍니다. 기본 135 = 적응도 +5, 팀컬러·강화 팀컬러 +8을 받아 148" />
                    <TextBlock Text="~" Margin="5,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                    <TextBox x:Name="MaxOvrBox" Width="55" />
                </StackPanel>
            </StackPanel>
            <StackPanel Margin="0,0,14,6">
                <TextBlock Text="가격" Style="{StaticResource FieldLabel}" />
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="MinPriceBox" Width="85" ToolTip="예: 1억, 5000만" />
                    <TextBlock Text="~" Margin="5,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                    <TextBox x:Name="MaxPriceBox" Width="85" />
                </StackPanel>
            </StackPanel>
            <StackPanel Margin="0,0,14,6"><TextBlock Text="약발" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="FootBox" MinWidth="90" /></StackPanel>
            <StackPanel Margin="0,0,14,6"><TextBlock Text="최대 급여" Style="{StaticResource FieldLabel}" /><TextBox x:Name="MaxPayBox" Width="50" /></StackPanel>
            <StackPanel Margin="0,0,14,6">
                <TextBlock Text="키 (cm)" Style="{StaticResource FieldLabel}" />
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="MinHeightBox" Width="50" />
                    <TextBlock Text="~" Margin="5,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                    <TextBox x:Name="MaxHeightBox" Width="50" />
                </StackPanel>
            </StackPanel>
            <StackPanel Margin="0,0,14,6"><TextBlock Text="체형" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="BodyBox" MinWidth="90" /></StackPanel>
            <StackPanel Margin="0,0,14,6"><TextBlock Text="이름" Style="{StaticResource FieldLabel}" /><TextBox x:Name="NameBox" Width="100" /></StackPanel>
        </WrapPanel>
        <WrapPanel>
            <StackPanel Margin="0,0,14,6"><TextBlock Text="특성 1" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="Trait1Box" MinWidth="130" /></StackPanel>
            <StackPanel Margin="0,0,14,6"><TextBlock Text="특성 2" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="Trait2Box" MinWidth="130" /></StackPanel>
            <StackPanel Margin="0,0,14,6">
                <TextBlock Text="능력치 조건 (이상, +1 기준)" Style="{StaticResource FieldLabel}" />
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="Stat1Box" MinWidth="95" /><TextBox x:Name="Stat1Value" Width="45" Margin="4,0,10,0" />
                    <ComboBox x:Name="Stat2Box" MinWidth="95" /><TextBox x:Name="Stat2Value" Width="45" Margin="4,0,10,0" />
                    <ComboBox x:Name="Stat3Box" MinWidth="95" /><TextBox x:Name="Stat3Value" Width="45" Margin="4,0,0,0" />
                </StackPanel>
            </StackPanel>
            <StackPanel Margin="0,0,14,6">
                <TextBlock Text="코어 능력치 (OVR 대비)" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="CoreGapBox" Width="60" ToolTip="포지션 핵심 능력치의 가중 평균 − OVR. 0 이상 = 핵심 능력치가 OVR만큼은 되는 카드, 음수면 헤더·슬라이딩처럼 OVR만 올리는 능력치가 많은 카드" />
            </StackPanel>
        </WrapPanel>
        <WrapPanel>
            <CheckBox x:Name="SkillBox" Content="개인기 5성 이상" Margin="0,2,16,0" />
            <CheckBox x:Name="TeamColorBox" Content="랭커 주요 팀컬러 20개 선수만" IsChecked="True" Margin="0,2,16,0"
                      ToolTip="어제 랭커가 가장 많이 쓴 소속 팀컬러 20개 중 하나라도 해당되는 카드만 (처음에는 팀컬러 멤버를 받느라 2분쯤 걸립니다)" />
            <CheckBox x:Name="OutlierBox" Content="호날두·호나우두·굴리트 제외" Margin="0,2,16,0" ToolTip="이름값이 가격을 정하는 카드. 가격 모델 학습에서는 항상 빠집니다" />
            <Button Content="조건 초기화" Style="{StaticResource Ghost}" Padding="8,2" Click="OnReset" />
        </WrapPanel>
    </StackPanel>
</UserControl>
