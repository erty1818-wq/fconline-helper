<UserControl x:Class="FcHelper.App.Studio.ValuePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:studio="clr-namespace:FcHelper.App.Studio"
             xmlns:app="clr-namespace:FcHelper.App">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource CardPanel}" Margin="0,0,0,10">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <Button x:Name="SearchButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="찾기" Click="OnSearch" />
                    <StackPanel>
                        <TextBlock Text="가성비 찾기" Style="{StaticResource H1}" />
                        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                   Text="비슷한 스펙의 예상가와 실제 시세를 비교합니다 [추정]. 싸다는 것은 비슷한 카드와 비교한 결과이고, 시세가 오른다는 뜻이 아닙니다. 과거 시세로 시험했을 때 싸다고 본 카드가 며칠 사이 더 오르지는 않았습니다. 호날두·호나우두·굴리트는 가격 학습에서 뺍니다." />
                    </StackPanel>
                </DockPanel>
                <WrapPanel>
                    <StackPanel Margin="0,0,14,6"><TextBlock Text="포지션" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="GroupBox" DisplayMemberPath="Name" SelectionChanged="OnGroupChanged" MinWidth="130" /></StackPanel>
                    <StackPanel Margin="0,0,14,6"><TextBlock Text="강화" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="GradeBox" MinWidth="70" SelectionChanged="OnGradeChanged" ToolTip="실사용 기본 +11 · +10도 선택할 수 있습니다." /></StackPanel>
                    <StackPanel Margin="0,0,14,6" VerticalAlignment="Bottom" Orientation="Horizontal">
                        <ToggleButton x:Name="CardsView" Style="{StaticResource Chip}" Content="가성비 카드" IsChecked="True" Click="OnView" Checked="OnView" />
                        <ToggleButton x:Name="FactorsView" Style="{StaticResource Chip}" Content="가격 요인 (이 포지션)" Click="OnView" Checked="OnView" />
                        <ToggleButton x:Name="TraitsView" Style="{StaticResource Chip}" Content="신특 평균 값어치" Click="OnView" Checked="OnView" />
                        <ToggleButton x:Name="SquadColorOnly" Style="{StaticResource Chip}" Content="스쿼드 소속 팀컬러만" Margin="14,0,0,0"
                                      ToolTip="스쿼드 짜기 화면에서 고른(또는 AI가 고른) 소속 팀컬러의 카드만 찾습니다." />
                    </StackPanel>
                </WrapPanel>
                <studio:FilterPanel x:Name="Filters" />
            </StackPanel>
        </Border>
        <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Foreground="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap" />
        <Grid>
            <DataGrid x:Name="Results" MouseDoubleClick="OnOpenCard" ToolTip="두 번 누르면 선수 정보를 엽니다.">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="꿀" Width="36" SortMemberPath="Discount">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{app:Icon Honey}" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="저평가 후보 [추정]: 비슷한 카드보다 쌈 [추정]: 예상가 대비 30% 이상 낮고 검증 오차보다 큰 차이, 거래 확인. 시세가 오른다는 뜻은 아닙니다">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Honey}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Honey}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="" Width="42">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><Image Width="34" Height="34" studio:Pictures.FaceOf="{Binding SpId}" RenderOptions.BitmapScalingMode="HighQuality" /></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="선수" Binding="{Binding Name}" Width="130" />
                    <DataGridTemplateColumn Header="시즌" Width="100" SortMemberPath="Season">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image Width="22" Height="22" studio:Pictures.SeasonOf="{Binding Season}" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Text="{Binding Season}" Margin="4,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="OVR" Binding="{Binding Ovr}" Width="45" />
                    <DataGridTextColumn Header="소속 팀컬러" Binding="{Binding Colors}" Width="110" />
                    <DataGridTextColumn Header="코어" Binding="{Binding Core}" Width="50" ElementStyle="{StaticResource Num}" SortMemberPath="CoreValue" />
                    <DataGridTextColumn Header="약발" Binding="{Binding WeakFoot}" Width="40" />
                    <DataGridTextColumn Header="급여" Binding="{Binding Pay}" Width="40" />
                    <DataGridTextColumn Header="키" Binding="{Binding Height}" Width="45" />
                    <DataGridTextColumn Header="코어 능력치 (+1)" Binding="{Binding Stats}" Width="200" />
                    <DataGridTextColumn Header="시세" Binding="{Binding Price}" Width="80" ElementStyle="{StaticResource Num}" />
                    <DataGridTextColumn Header="예상가 [추정]" Binding="{Binding Expected}" Width="90" ElementStyle="{StaticResource Num}" />
                    <DataGridTextColumn Header="차이" Binding="{Binding Diff}" Width="55" ElementStyle="{StaticResource Good}" SortMemberPath="Discount" />
                    <DataGridTextColumn Header="검증 중앙오차" Binding="{Binding ModelError}" Width="95" />
                    <DataGridTextColumn Header="가격 차이 해석" Binding="{Binding Evidence}" Width="165" />
                    <DataGridTextColumn Header="특성 · 개인기 · 체형" Binding="{Binding Tags}" Width="190" />
                </DataGrid.Columns>
            </DataGrid>
            <DataGrid x:Name="Factors" Visibility="Collapsed">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="요인" Binding="{Binding Name}" Width="170" />
                    <DataGridTextColumn Header="구분" Binding="{Binding Kind}" Width="175" />
                    <DataGridTextColumn Header="가격 영향" Binding="{Binding Percent}" Width="80" ElementStyle="{StaticResource Num}" SortMemberPath="PercentValue" />
                    <DataGridTextColumn Header="근사 95% 범위" Binding="{Binding Range}" Width="110" ElementStyle="{StaticResource Num}" />
                    <DataGridTextColumn Header="OVR 환산" Binding="{Binding Ovr}" Width="75" ElementStyle="{StaticResource Num}" SortMemberPath="OvrValue" />
                    <DataGridTextColumn Header="중간 카드 기준 BP" Binding="{Binding Bp}" Width="110" ElementStyle="{StaticResource Num}" />
                    <DataGridTextColumn Header="카드 수" Binding="{Binding Cards}" Width="60" ElementStyle="{StaticResource Num}" />
                    <DataGridTextColumn Header="선수 수" Binding="{Binding Players}" Width="60" ElementStyle="{StaticResource Num}" />
                    <DataGridTextColumn Header="판정" Binding="{Binding Verdict}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</UserControl>
