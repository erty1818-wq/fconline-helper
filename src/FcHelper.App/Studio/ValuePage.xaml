<UserControl x:Class="FcHelper.App.Studio.ValuePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource CardPanel}" Margin="0,0,0,10">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <Button x:Name="SearchButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="찾기" Click="OnSearch" />
                    <StackPanel>
                        <TextBlock Text="가성비 찾기" Style="{StaticResource H1}" />
                        <TextBlock Style="{StaticResource Hint}" Text="같은 OVR·약발·급여·능력치·특성·개인기·시즌 카드들의 오늘 시세보다 싸게 거래되는 카드 [추정]" />
                    </StackPanel>
                </DockPanel>
                <WrapPanel>
                    <StackPanel Margin="0,0,14,0"><TextBlock Text="포지션" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="GroupBox" DisplayMemberPath="Name" SelectionChanged="OnGroupChanged" MinWidth="130" /></StackPanel>
                    <StackPanel Margin="0,0,14,0"><TextBlock Text="강화" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="GradeBox" MinWidth="70" /></StackPanel>
                    <StackPanel Margin="0,0,14,0"><TextBlock Text="최소 가격" Style="{StaticResource FieldLabel}" /><TextBox x:Name="MinBox" Width="100" /></StackPanel>
                    <StackPanel Margin="0,0,14,0"><TextBlock Text="최대 가격" Style="{StaticResource FieldLabel}" /><TextBox x:Name="MaxBox" Width="100" /></StackPanel>
                    <StackPanel Margin="0,0,14,0"><TextBlock Text="약발" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="FootBox" /></StackPanel>
                    <StackPanel Margin="0,0,14,0"><TextBlock Text="특성" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="TraitBox" MinWidth="140" /></StackPanel>
                    <CheckBox x:Name="SkillBox" Content="개인기 5성 이상" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                </WrapPanel>
            </StackPanel>
        </Border>
        <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Foreground="{StaticResource Muted}" Margin="0,8,0,0" />
        <DataGrid x:Name="Results">
            <DataGrid.Columns>
                <DataGridTextColumn Header="선수" Binding="{Binding Name}" Width="140" />
                <DataGridTextColumn Header="시즌" Binding="{Binding Season}" Width="80" />
                <DataGridTextColumn Header="OVR" Binding="{Binding Ovr}" Width="50" />
                <DataGridTextColumn Header="약발" Binding="{Binding WeakFoot}" Width="45" />
                <DataGridTextColumn Header="급여" Binding="{Binding Pay}" Width="45" />
                <DataGridTextColumn Header="핵심 능력치" Binding="{Binding Stats}" Width="*" />
                <DataGridTextColumn Header="시세" Binding="{Binding Price}" Width="85" ElementStyle="{StaticResource Num}" />
                <DataGridTextColumn Header="예상가 [추정]" Binding="{Binding Expected}" Width="95" ElementStyle="{StaticResource Num}" />
                <DataGridTextColumn Header="차이" Binding="{Binding Diff}" Width="65" ElementStyle="{StaticResource Good}" SortMemberPath="Discount" />
                <DataGridTextColumn Header="특성 · 개인기 · 체형" Binding="{Binding Tags}" Width="200" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
