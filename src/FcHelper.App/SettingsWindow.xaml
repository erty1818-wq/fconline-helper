<Window x:Class="FcHelper.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FC Online Helper 설정" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen" FontFamily="Malgun Gothic, Segoe UI">
    <StackPanel Margin="16">
        <TextBlock Style="{StaticResource Section}" Text="NEXON Open API 키" Margin="0,0,0,3" />
        <PasswordBox x:Name="ApiKeyBox" />
        <TextBlock Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"
                   Text="openapi.nexon.com에서 FC온라인 앱을 등록하고 받은 키. Windows 계정 암호화(DPAPI)로 이 PC에만 저장됩니다." />

        <TextBlock Style="{StaticResource Section}" Text="내 닉네임 (재대결 전적 · 상성 경보용, 선택)" />
        <TextBox x:Name="MyNicknameBox" />

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource Section}" Text="분석 경기 수" Margin="0,0,0,3" />
                <TextBox x:Name="WindowBox" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource Section}" Text="초당 API 호출 한도" Margin="0,0,0,3" />
                <TextBox x:Name="RateBox" />
            </StackPanel>
        </Grid>
        <TextBlock Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"
                   Text="처음 만난 상대는 분석 경기 수만큼 API를 호출합니다. 호출 한도는 앱 등록 화면의 값에 맞추세요." />

        <CheckBox x:Name="VoiceBox" Content="검색 결과를 음성으로 읽어주기 (한국어 음성 필요)" Margin="0,12,0,4" />
        <CheckBox x:Name="TopmostBox" Content="검색 창을 항상 위에 표시" />
        <CheckBox x:Name="StartupBox" Content="Windows 시작 시 트레이로 실행" />

        <TextBlock Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0"
                   Text="단축키: Ctrl + Alt + S = 상대 검색 창 열기" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="취소" IsCancel="True" Margin="0,0,6,0" />
            <Button Content="저장" IsDefault="True" Click="OnSaveClick" />
        </StackPanel>
    </StackPanel>
</Window>
