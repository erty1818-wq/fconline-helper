<Window x:Class="FcHelper.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FC Online Helper 설정" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="16">
        <TextBlock Style="{StaticResource Section}" Text="NEXON Open API 키" Margin="0,0,0,3" />
        <PasswordBox x:Name="ApiKeyBox" />
        <TextBlock Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"
                   Text="openapi.nexon.com에서 FC온라인 앱을 등록하고 받은 키. Windows 계정 암호화(DPAPI)로 이 PC에만 저장됩니다." />

        <TextBlock Style="{StaticResource Section}" Text="내 닉네임 (재대결 전적 · 상성 경보용, 선택)" />
        <TextBox x:Name="MyNicknameBox" />

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource Section}" Text="분석 경기 수" Margin="0,0,0,3" />
                <TextBox x:Name="WindowBox" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource Section}" Text="초당 API 호출 한도" Margin="0,0,0,3" />
                <TextBox x:Name="RateBox" />
            </StackPanel>
        </Grid>
        <TextBlock Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"
                   Text="처음 만난 상대는 분석 경기 수만큼 API를 호출합니다. 호출 한도는 앱 등록 화면의 값에 맞추세요." />

        <TextBlock Style="{StaticResource Section}" Text="상대 인식 방식" />
        <RadioButton x:Name="HotkeyModeBox" GroupName="Detection" Foreground="{StaticResource Text}" Margin="0,2"
                     Content="반자동: Ctrl + Alt + F로 화면을 읽어 검색" />
        <RadioButton x:Name="ManualModeBox" GroupName="Detection" Foreground="{StaticResource Text}" Margin="0,2"
                     Content="수동: 닉네임을 직접 입력 (Ctrl + Alt + S)" />
        <RadioButton x:Name="AutoModeBox" GroupName="Detection" Foreground="{StaticResource Text}" Margin="0,2"
                     Content="자동: 매칭 카드 · 종료 카드가 저절로 뜸" />
        <TextBlock Foreground="{StaticResource Muted}" FontSize="11" Margin="20,0,0,4" TextWrapping="Wrap"
                   Text="게임 창이 앞에 있을 때만 2초마다 점수판 부분을 읽습니다(게임 파일·메모리에는 손대지 않음). Ctrl + Alt + F도 그대로 쓸 수 있습니다." />
        <CheckBox x:Name="SaveCapturesBox" Content="인식한 화면을 저장 (개발용, 인식 개선에 사용)" />
        <TextBlock Style="{StaticResource Section}" Text="매칭 카드에 보일 정보 (창 크기는 자동)" />
        <WrapPanel x:Name="CardSectionsPanel" />

        <CheckBox x:Name="MarketBox" Content="위험 선수의 능력치·시세 표시 (FC온라인 데이터센터에서 조회)" Margin="0,12,0,4" />
        <CheckBox x:Name="MarketRefreshBox" Content="가성비 찾기 시세 자동 갱신 (하루 1번 · 새 시즌은 바로 · 게임 중에는 미룸)" />
        <CheckBox x:Name="AutoUpdateBox" Content="자동 업데이트 (새 버전을 미리 받아 두고 다음에 켤 때 적용 · 알림은 항상 표시)" />
        <CheckBox x:Name="VoiceBox" Content="검색 결과를 음성으로 읽어주기 (한국어 음성 필요)" />
        <CheckBox x:Name="StartupBox" Content="Windows 시작 시 트레이로 실행" />

        <TextBlock Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0"
                   Text="Ctrl + Alt + S = 검색 창 열기 · Esc = 닫기. 인식한 카드는 게임 창 옆에 뜨고 게임 입력을 빼앗지 않습니다." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="취소" IsCancel="True" Margin="0,0,6,0" />
            <Button Content="저장" IsDefault="True" Click="OnSaveClick" />
        </StackPanel>
    </StackPanel>
</Window>
